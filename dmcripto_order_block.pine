szPoc    = input.string("Pequeño", "POC (perfil de volumen)", options=["Oculto", "Muy pequeño", "Pequeño", "Normal", "Grande"], group=grpSz)
szCard   = input.string("Pequeño", "Tarjetas de zonas OB / FVG ('Oculto' deja solo el icono ⓘ)", options=["Oculto", "Muy pequeño", "Pequeño", "Normal", "Grande"], group=grpSz)
szStruct = input.string("Pequeño", "Estructura BOS / CHoCH", options=["Oculto", "Muy pequeño", "Pequeño", "Normal", "Grande"], group=grpSz)
szWhy    = input.string("Pequeño", "Avisos «tocó zona pero no es señal» (✖ falta: ...)", options=["Oculto", "Muy pequeño", "Pequeño", "Normal", "Grande"], group=grpSz, tooltip="Naranja con texto negro para que se lea bien. Dice en palabras simples qué filtro falta. Pasa el mouse para ver el detalle.")
szHL     = input.string("Pequeño", "HH / HL / LH / LL en los pivotes", options=["Oculto", "Muy pequeño", "Pequeño", "Normal", "Grande"], group=grpSz)
szIStruct = input.string("Pequeño", "Estructura interna iBOS / iCHoCH", options=["Oculto", "Muy pequeño", "Pequeño", "Normal", "Grande"], group=grpSz)
szFib    = input.string("Pequeño", "Fibonacci (niveles y plan)", options=["Oculto", "Muy pequeño", "Pequeño", "Normal", "Grande"], group=grpSz)
szPos    = input.string("Muy pequeño", "POSIBLE LONG / SHORT", options=["Oculto", "Muy pequeño", "Pequeño", "Normal", "Grande"], group=grpSz)
lblShort = input.bool(true, "Texto corto en liquidaciones (sin '~' ni 'est.')", group=grpSz)
lblIcons = input.bool(true, "Etiquetas con iconos y palabras simples (en vez de siglas PDH / PWH / LIQ / POC)", group=grpSz, tooltip="ON: 📅 Máx. de ayer, 📆 Mín. semana, ⬆💥 Cortos 25x (liquidación de cortos), 🎯 POC... y al pasar el mouse sobre la etiqueta se explica qué significa. OFF: siglas técnicas.")

f_sz(string s) => s == "Muy pequeño" ? size.tiny : s == "Pequeño" ? size.small : s == "Normal" ? size.normal : size.large
f_hf(string s) => s == "Muy pequeño" ? 0.85 : s == "Pequeño" ? 1.0 : s == "Normal" ? 1.35 : 1.8

grpOsc = "🔗 Oscilador (IGUAL que en el OSCILADOR V3.0)"
rsiLenConf   = input.int(14, "RSI", group=grpOsc)
stochLenConf = input.int(14, "Estocástico", group=grpOsc)
stochSmoothConf = input.int(3, "Suavizado %K del Estocástico (igual que el oscilador)", minval=1, maxval=10, group=grpOsc, tooltip="Debe coincidir con el valor del OSCILADOR V3.0 para que ambos lean lo mismo. 1 = sin suavizar.")
obLevelConf  = input.int(75, "Sobrecompra", group=grpOsc)
osLevelConf  = input.int(25, "Sobreventa", group=grpOsc)
useCombined  = input.bool(true, "Exigir confirmación del oscilador", group=grpOsc, tooltip="RECOMENDADO ON: tu protección anti-FOMO. Una señal LONG solo nace con el oscilador en sobreventa y una SHORT con sobrecompra.")
useExhFilter = input.bool(false, "Exigir agotamiento reciente", group=grpOsc)
exhLookback  = input.int(10, "Vigencia agotamiento (barras)", group=grpOsc)

grpADX = "📈 ADX + CONTEXTO DMCRIPTO"
adxLen    = input.int(14, "Longitud", group=grpADX)
adxSmooth = input.int(14, "Suavizado", group=grpADX)
adxWeakLvl   = input.int(20, "Umbral débil", group=grpADX)
adxStrongLvl = input.int(25, "Umbral fuerte", group=grpADX)
requireADX   = input.bool(true, "Bloquear señales con ADX débil", group=grpADX, tooltip="ON por defecto: evita entrar en mercado plano/lateral (rango), que es donde más se pierde con estrategias de zona/ruptura. Clave para winrate ≥50% en 1-15m.")
ctxDeltaLen  = input.int(20, "Período del Delta de Volumen (contexto)", minval=5, group=grpADX)
ctxMode = input.string("Bloquear señales en contra", "Modo CONTEXTO ADX", options=["Solo información", "Confirmar señales (✅/⚠️)", "Bloquear señales en contra"], group=grpADX, tooltip="ON por defecto en 'Bloquear': solo deja pasar señales a favor del flujo dominante de DI+/DI- y Delta de volumen. Reduce señales pero sube la calidad/winrate.")

grpEntry = "🎯 Entrada / TP / SL"
showEntryPanel = input.bool(true, "Mostrar panel de operación", group=grpEntry)
panelCompact = input.bool(true, "Panel compacto (solo lo esencial: estado, asistente, zona, oscilador, perfil y sesión)", group=grpEntry, tooltip="ON: panel chico que no tapa el gráfico. OFF: panel completo con ratio, ADX, DI, delta, liquidaciones, dominancia y tamaño de posición.")
showTradeLines = input.bool(false, "Dibujar también líneas Entrada/TP/SL", group=grpEntry)
showTradeZones = input.bool(true, "Zonas sombreadas de riesgo (rojo) y ganancia (verde)", group=grpEntry)
rrInput = input.string("Automático", "Riesgo:Beneficio (TP1)", options=["0.5:1", "0.8:1", "1:1", "1.2:1", "1.5:1", "2:1", "3:1", "Automático"], group=grpEntry)
tfSec  = timeframe.in_seconds()
rrAuto = tfSec <= 120 ? 1.0 : tfSec <= 300 ? 1.2 : tfSec <= 900 ? 1.5 : tfSec <= 3600 ? 1.8 : tfSec <= 14400 ? 2.0 : tfSec <= 86400 ? 2.5 : tfSec <= 604800 ? 3.0 : 3.5
rr     = rrInput == "0.5:1" ? 0.5 : rrInput == "0.8:1" ? 0.8 : rrInput == "1:1" ? 1.0 : rrInput == "1.2:1" ? 1.2 : rrInput == "1.5:1" ? 1.5 : rrInput == "2:1" ? 2.0 : rrInput == "3:1" ? 3.0 : rrAuto
useMultiTP = input.bool(true, "TP2 y TP3 automáticos (modo runner)", group=grpEntry, tooltip="Al tocar TP1: el SL pasa a BE y aparece TP2. Al tocar TP2: el SL pasa a TP1 (ganancia asegurada) y aparece TP3. Si el precio se devuelve, te quedas con el último nivel asegurado.")
tp2R = input.float(1.5, "TP2 (x riesgo)", minval=0.5, step=0.1, group=grpEntry)
tp3R = input.float(2.5, "TP3 (x riesgo)", minval=0.5, step=0.1, group=grpEntry)
slBuffer = input.float(0.15, "Colchón SL (x ATR)", step=0.05, group=grpEntry)
useAutoMinSL = input.bool(true, "SL mínimo automático (según timeframe)", group=grpEntry, tooltip="ON por defecto: calcula el SL mínimo según el timeframe (más ancho en 1m, más ajustado en 15m) para que el ruido normal de una vela no te saque de la operación. Desactívalo para fijar tú mismo el valor.")
minSLatrManual = input.float(0.6, "SL mínimo manual (x ATR)", minval=0.1, step=0.1, group=grpEntry, tooltip="Solo se usa si 'SL mínimo automático' está OFF.")
minSLatrAuto = tfSec <= 180 ? 0.8 : tfSec <= 300 ? 0.7 : tfSec <= 900 ? 0.5 : 0.4
minSLatr = useAutoMinSL ? minSLatrAuto : minSLatrManual
enableBE = input.bool(true, "Mover SL a Break Even", group=grpEntry)
bePct    = input.float(50, "BE al alcanzar % del camino a TP1", step=5, group=grpEntry)
tblPos  = input.string("Arriba Izquierda", "Posición panel (PC)", options=["Arriba Derecha","Abajo Derecha","Arriba Izquierda","Abajo Izquierda"], group=grpEntry)
tblSize = input.string("Grande", "Tamaño texto panel (PC)", options=["Pequeño","Normal","Grande"], group=grpEntry)

grpStats = "📊 Estadísticas"
showStats = input.bool(true, "Mostrar panel de estadísticas", group=grpStats)
stPos = input.string("Abajo Derecha", "Posición estadísticas (PC)", options=["Arriba Derecha","Abajo Derecha","Arriba Izquierda","Abajo Izquierda"], group=grpStats)

// ------------------- SESIONES (3 + ZONA HORARIA) -------------------
grpSess = "🕐 Niveles de Sesión y Referencia"
showSessLevels = input.bool(false, "Mostrar Máx/Mín de Asia, Londres y NY", group=grpSess)
sessAsia = input.session("0000-0800", "Sesión Asia", group=grpSess)
sessLDN  = input.session("0700-1600", "Sesión Londres", group=grpSess)
sessNY   = input.session("1300-2200", "Sesión Nueva York", group=grpSess)
tzSel    = input.string("UTC", "Zona horaria de los horarios", options=["UTC", "España (Madrid)", "México (Ciudad de México)", "Colombia (Bogotá)", "Perú (Lima)", "Ecuador (Guayaquil)", "Bolivia (La Paz)", "Venezuela (Caracas)", "Chile (Santiago)", "Argentina (Buenos Aires)", "Rep. Dominicana (Santo Domingo)", "Estados Unidos (Nueva York)", "Otro (manual)"], group=grpSess)
tzManual = input.string("America/Bogota", "Zona horaria manual (solo si elegiste 'Otro')", group=grpSess)
asiaCol  = input.color(color.new(color.purple, 20), "Color niveles Asia", group=grpSess)
ldnCol   = input.color(color.new(color.orange, 20), "Color niveles Londres", group=grpSess)
nyCol    = input.color(color.new(color.blue, 20), "Color niveles NY", group=grpSess)
showPDH  = input.bool(false, "Mostrar MÁX. ANTERIOR (día previo)", group=grpSess)
showPDL  = input.bool(false, "Mostrar MÍN. ANTERIOR (día previo)", group=grpSess)
showEQ      = input.bool(false, "Línea Equilibrium (50% del rango)", group=grpSess, tooltip="Mitad del rango actual: arriba = Premium (caro), abajo = Discount (barato). OFF por defecto: la caja Equilibrio muestra lo mismo.")
showRotura  = input.bool(false, "Líneas Rotura Long/Short (gatillos)", group=grpSess, tooltip="Nivel del último pivote: si el precio lo rompe, confirma continuación a favor de esa rotura. Desactivado por defecto para limpieza (se solapa con Máx/Mín MAYOR).")

grpHTF = "🌐 Sesgo HTF"
requireHTF = input.bool(false, "Exigir sesgo HTF", group=grpHTF)
useAutoHTF = input.bool(true, "Timeframe HTF automático (según el gráfico)", group=grpHTF, tooltip="ON por defecto: si activás 'Exigir sesgo HTF', el timeframe de referencia se adapta solo al gráfico en el que estés parado (1-3m usa 1h, 5-15m usa 4h, 30m-1h usa Diario, 4h usa Semanal, Diario usa Semanal, Semanal+ usa Mensual). Así funciona igual en cualquier temporalidad sin tener que reconfigurar nada.")
htfTF      = input.timeframe("240", "Timeframe HTF (manual)", group=grpHTF, tooltip="Solo se usa si 'Timeframe HTF automático' está OFF.")
htfEmaLen  = input.int(50, "EMA HTF", group=grpHTF)

// ------------------- MEDIAS MÓVILES (EMA) -------------------
grpEMA = "📉 Medias Móviles (EMA)"
showEMA50  = input.bool(true, "Mostrar EMA 50", group=grpEMA)
ema50Len   = input.int(50, "Longitud EMA 50", minval=1, group=grpEMA)
ema50Color = input.color(color.blue, "Color EMA 50", group=grpEMA)
showEMA200 = input.bool(true, "Mostrar EMA 200", group=grpEMA)
ema200Len  = input.int(200, "Longitud EMA 200", minval=1, group=grpEMA)
ema200Color = input.color(color.orange, "Color EMA 200", group=grpEMA)

grpBridge = "📨 Puente de señales"
sendBridge = input.bool(true, "Enviar señales LONG/SHORT con datos (entrada, TP, SL, R:R) por alert()", group=grpBridge, tooltip="Crea la alerta con condición 'Cualquier llamada a alert()' en este indicador. El mensaje es un JSON listo para el puente por correo / webhook.")

// ------------------- CÁLCULOS BASE -------------------
atr = ta.atr(atrLen)
vMA = ta.sma(volume, whaleLen)
maxOBs = mobileMode ? math.min(3, maxOBsInput) : maxOBsInput
maxFZs = mobileMode ? math.min(4, maxFZsInput) : maxFZsInput

f_px(float x) => str.tostring(x, format.mintick)
f_strengthCol(string s, bool bull, int trans) => s == "FUERTE" ? color.new(bull ? color.green : color.red, trans) : s == "MODERADO" ? color.new(color.orange, trans) : color.new(color.gray, trans)
f_volFmt(float v) => v >= 1000000 ? str.tostring(v / 1000000, "#.##") + "M" : v >= 1000 ? str.tostring(v / 1000, "#.##") + "K" : str.tostring(v, "#")

f_integ(float maxFill) => math.max(0.0, 100.0 - maxFill)
f_dom(float d) => d >= domTh ? "COMPRADORES" : d <= -domTh ? "VENDEDORES" : "NEUTRAL"
f_domShort(float d) => d >= domTh ? "Compradores" : d <= -domTh ? "Vendedores" : "Neutral"
f_legDelta(int n) =>
    float sd = 0.0
    float sv = 0.0
    for k = 0 to n
        float r = high[k] - low[k]
        sd += r > 0 ? volume[k] * (2 * close[k] - high[k] - low[k]) / r : 0.0
        sv += volume[k]
    sv > 0 ? sd / sv * 100 : 0.0

tz = tzSel == "España (Madrid)" ? "Europe/Madrid" : tzSel == "México (Ciudad de México)" ? "America/Mexico_City" : tzSel == "Colombia (Bogotá)" ? "America/Bogota" : tzSel == "Perú (Lima)" ? "America/Lima" : tzSel == "Ecuador (Guayaquil)" ? "America/Guayaquil" : tzSel == "Bolivia (La Paz)" ? "America/La_Paz" : tzSel == "Venezuela (Caracas)" ? "America/Caracas" : tzSel == "Chile (Santiago)" ? "America/Santiago" : tzSel == "Argentina (Buenos Aires)" ? "America/Argentina/Buenos_Aires" : tzSel == "Rep. Dominicana (Santo Domingo)" ? "America/Santo_Domingo" : tzSel == "Estados Unidos (Nueva York)" ? "America/New_York" : tzSel == "Otro (manual)" ? tzManual : "UTC"

osc   = (ta.rsi(close, rsiLenConf) + ta.sma(ta.stoch(close, high, low, stochLenConf), stochSmoothConf)) / 2
oscOB = osc >= obLevelConf
oscOS = osc <= osLevelConf

var int bOBc = 0
var int bOSc = 0
var int xOB = 0
var int xOS = 0
var bool wOB = false
var bool wOS = false

if oscOB
    bOBc := bOBc + 1
    wOB := true
    xOB := 0
else if wOB
    xOB := xOB + 1
    if xOB > 2
        bOBc := 0
        wOB := false
else
    bOBc := 0

if oscOS
    bOSc := bOSc + 1
    wOS := true
    xOS := 0
else if wOS
    xOS := xOS + 1
    if xOS > 2
        bOSc := 0
        wOS := false
else
    bOSc := 0

exhBull = bOSc[1] >= 3 and osc > osLevelConf and osc[1] <= osLevelConf
exhBear = bOBc[1] >= 3 and osc < obLevelConf and osc[1] >= obLevelConf
bsExhBull = ta.barssince(exhBull)
bsExhBear = ta.barssince(exhBear)
exhBullOK = not useExhFilter or (not na(bsExhBull) and bsExhBull <= exhLookback)
exhBearOK = not useExhFilter or (not na(bsExhBear) and bsExhBear <= exhLookback)

[diP, diM, adx] = ta.dmi(adxLen, adxSmooth)
adxIsWeak   = adx < adxWeakLvl
adxIsStrong = adx >= adxStrongLvl
adxOK = not requireADX or not adxIsWeak

// CONTEXTO ADX DMCRIPTO (integrado)
dirVol   = close > open ? volume : close < open ? -volume : 0.0
netDelta = math.sum(dirVol, ctxDeltaLen)
totVol   = math.sum(volume, ctxDeltaLen)
deltaPct = totVol != 0 ? netDelta / totVol * 100 : 0.0
bullConf = diP > diM and deltaPct > 0
bearConf = diM > diP and deltaPct < 0
ctxBias = bearConf or (diM > diP and adx >= adxWeakLvl) ? "SHORT" : bullConf or (diP > diM and adx >= adxWeakLvl) ? "LONG" : "NEUTRO"
ctxBlock = ctxMode == "Bloquear señales en contra"
ctxMark  = ctxMode == "Confirmar señales (✅/⚠️)"
ctxLongOK  = not ctxBlock or ctxBias == "LONG"
ctxShortOK = not ctxBlock or ctxBias == "SHORT"

htfTFAuto = tfSec <= 180 ? "60" : tfSec <= 900 ? "240" : tfSec <= 3600 ? "1D" : tfSec <= 14400 ? "1W" : tfSec <= 86400 ? "1W" : "1M"
htfTFUsed = useAutoHTF ? htfTFAuto : htfTF
htfC = request.security(syminfo.tickerid, htfTFUsed, close[1], lookahead=barmerge.lookahead_on)
htfE = request.security(syminfo.tickerid, htfTFUsed, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_on)
htfBullOK = not requireHTF or htfC > htfE
htfBearOK = not requireHTF or htfC < htfE

ema50v  = ta.ema(close, ema50Len)
ema200v = ta.ema(close, ema200Len)
plot(showEMA50 ? ema50v : na, "EMA 50", ema50Color, 1)
plot(showEMA200 ? ema200v : na, "EMA 200", ema200Color, 2)

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float lPH = na
var float lPL = na
var int lPHb = na
var int lPLb = na
if not na(ph)
    lPH := ph
    lPHb := bar_index - swingLen
if not na(pl)
    lPL := pl
    lPLb := bar_index - swingLen
bosUp = not na(lPH) and close > lPH and close[1] <= lPH
bosDn = not na(lPL) and close < lPL and close[1] >= lPL
var bool trendUp = false
if bosUp
    trendUp := true
if bosDn
    trendUp := false
chochUp = bosUp and not trendUp[1]
chochDn = bosDn and trendUp[1]

// Estructura SWING (ruptura importante) para distinguir OB swing de OB internos
phBig = ta.pivothigh(high, swingBigLen, swingBigLen)
plBig = ta.pivotlow(low, swingBigLen, swingBigLen)
var float lPHBig = na
var float lPLBig = na
var int lastBigUp = -1000
var int lastBigDn = -1000
var int lPHBigb = na
var int lPLBigb = na
if not na(phBig)
    lPHBig := phBig
    lPHBigb := bar_index - swingBigLen
if not na(plBig)
    lPLBig := plBig
    lPLBigb := bar_index - swingBigLen
if not na(lPHBig) and close > lPHBig and close[1] <= lPHBig
    lastBigUp := bar_index
if not na(lPLBig) and close < lPLBig and close[1] >= lPLBig
    lastBigDn := bar_index
swingUpNow = bar_index - lastBigUp <= 2
swingDnNow = bar_index - lastBigDn <= 2

iph = ta.pivothigh(high, internalSwingLen, internalSwingLen)
ipl = ta.pivotlow(low, internalSwingLen, internalSwingLen)
var float ilPH = na
var float ilPL = na
var int ilPHb = na
var int ilPLb = na
if not na(iph)
    ilPH := iph
    ilPHb := bar_index - internalSwingLen
if not na(ipl)
    ilPL := ipl
    ilPLb := bar_index - internalSwingLen
ibosUp = not na(ilPH) and close > ilPH and close[1] <= ilPH
ibosDn = not na(ilPL) and close < ilPL and close[1] >= ilPL
var bool itrendUp = false
if ibosUp
    itrendUp := true
if ibosDn
    itrendUp := false
ichochUp = ibosUp and not itrendUp[1]
ichochDn = ibosDn and itrendUp[1]

var array<line>  structLines = array.new<line>()
var array<label> structLbls = array.new<label>()
f_structMark(int x1, float lvl, bool bull, string txt, bool internal) =>
    int xs = math.max(x1, bar_index - 480)
    int xm = math.round((xs + bar_index) / 2.0)
    color c = bull ? color.new(color.teal, 0) : color.new(color.red, 0)
    structLines.push(line.new(xs, lvl, bar_index, lvl, color=c, style=internal ? line.style_dashed : line.style_solid, width=1))
    structLbls.push(label.new(xm, lvl, txt, style=bull ? label.style_label_down : label.style_label_up, color=color.new(color.white, 100), textcolor=c, size=internal ? f_sz(szIStruct) : f_sz(szStruct)))
    while structLines.size() > structKeep
        line.delete(structLines.shift())
    while structLbls.size() > structKeep
        label.delete(structLbls.shift())

showStruct = not masterClean or showBOSLabels
if showInternalStruct and szIStruct != "Oculto" and ibosUp and not na(ilPHb) and not (bosUp and ilPH == lPH)
    f_structMark(ilPHb, ilPH, true, ichochUp ? "iCHoCH" : "iBOS", true)
if showInternalStruct and szIStruct != "Oculto" and ibosDn and not na(ilPLb) and not (bosDn and ilPL == lPL)
    f_structMark(ilPLb, ilPL, false, ichochDn ? "iCHoCH" : "iBOS", true)
if showStruct and szStruct != "Oculto" and bosUp and not na(lPHb)
    f_structMark(lPHb, lPH, true, chochUp ? "CHoCH" : "BOS", false)
if showStruct and szStruct != "Oculto" and bosDn and not na(lPLb)
    f_structMark(lPLb, lPL, false, chochDn ? "CHoCH" : "BOS", false)

// HH / HL / LH / LL en los pivotes de la estructura principal
var array<label> hhLbls = array.new<label>()
if showHHLL and szHL != "Oculto" and not na(ph) and not na(lPH[1])
    hhLbls.push(label.new(bar_index - swingLen, ph, ph > lPH[1] ? "HH" : "LH", style=label.style_label_down, color=color.new(ph > lPH[1] ? color.teal : color.red, 55), textcolor=color.white, size=f_sz(szHL)))
if showHHLL and szHL != "Oculto" and not na(pl) and not na(lPL[1])
    hhLbls.push(label.new(bar_index - swingLen, pl, pl > lPL[1] ? "HL" : "LL", style=label.style_label_up, color=color.new(pl > lPL[1] ? color.teal : color.red, 55), textcolor=color.white, size=f_sz(szHL)))
while hhLbls.size() > structKeep
    label.delete(hhLbls.shift())

f_hLine(float y, color col, int w, int sty) =>
    line.new(bar_index - lvlLineBack, y, bar_index + colLevels, y, color=col, width=w, style=sty == 1 ? line.style_dashed : sty == 2 ? line.style_dotted : line.style_solid)

type LiqLevel
    line ln
    float lvl
    int touches
    bool active
    bool isSR
    int lastTouch
    label lb

var array<LiqLevel> liqHigh = array.new<LiqLevel>()
var array<LiqLevel> liqLow = array.new<LiqLevel>()

f_near(float px) => srMaxATR <= 0 or (not na(px) and math.abs(px - close) <= atr * srMaxATR)

f_hasLevel(array<LiqLevel> arr, float px) =>
    bool found = false
    if not na(px) and arr.size() > 0
        for k = 0 to arr.size() - 1
            LiqLevel q = arr.get(k)
            if q.active and q.lvl == px
                found := true
    found

f_dropOldest(array<LiqLevel> arr) =>
    int idx = 0
    for k = 0 to arr.size() - 1
        if not arr.get(k).isSR
            idx := k
            break
    LiqLevel old = arr.remove(idx)
    if not na(old.ln)
        line.delete(old.ln)
    if not na(old.lb)
        label.delete(old.lb)

phLiq = ta.pivothigh(high, liqLen, liqLen)
plLiq = ta.pivotlow(low, liqLen, liqLen)

if showLiq and not na(phLiq)
    found = false
    if liqHigh.size() > 0
        for idx = 0 to liqHigh.size() - 1
            LiqLevel lvl = liqHigh.get(idx)
            if lvl.active and math.abs(lvl.lvl - phLiq) <= atr * liqTolATR
                found := true
                break
    if not found
        liqHigh.push(LiqLevel.new(f_hLine(phLiq, liqCol, 1, 2), phLiq, 0, true, false, -1000, na))
        while liqHigh.size() > maxLiq
            f_dropOldest(liqHigh)

if showLiq and not na(plLiq)
    found = false
    if liqLow.size() > 0
        for idx = 0 to liqLow.size() - 1
            LiqLevel lvl = liqLow.get(idx)
            if lvl.active and math.abs(lvl.lvl - plLiq) <= atr * liqTolATR
                found := true
                break
    if not found
        liqLow.push(LiqLevel.new(f_hLine(plLiq, liqCol, 1, 2), plLiq, 0, true, false, -1000, na))
        while liqLow.size() > maxLiq
            f_dropOldest(liqLow)

sweepBearNow = false
sweepBullNow = false

iH = liqHigh.size() - 1
while iH >= 0
    LiqLevel lvl = liqHigh.get(iH)
    if lvl.active
        if high >= lvl.lvl - atr * liqTolATR and high <= lvl.lvl + atr * liqTolATR and close < lvl.lvl and bar_index - lvl.lastTouch > liqLen
            lvl.touches := lvl.touches + 1
            lvl.lastTouch := bar_index
            if lvl.touches >= srMin and not lvl.isSR
                lvl.isSR := true
                if not na(lvl.ln)
                    line.set_color(lvl.ln, resCol)
                    line.set_width(lvl.ln, 2)
                    line.set_style(lvl.ln, line.style_solid)
                if showSRLabel and szLvl != "Oculto" and na(lvl.lb)
                    lvl.lb := label.new(bar_index, lvl.lvl, "RESISTENCIA " + f_px(lvl.lvl), style=label.style_label_left, color=resCol, textcolor=color.white, size=f_sz(szLvl))
        realSweepHigh = high > lvl.lvl + atr * liqTolATR and close < lvl.lvl
        brokeAboveHigh = close > lvl.lvl
        if realSweepHigh or brokeAboveHigh
            if realSweepHigh
                sweepBearNow := true
            lvl.active := false
            if not na(lvl.ln)
                line.delete(lvl.ln)
                lvl.ln := na
            if not na(lvl.lb)
                label.delete(lvl.lb)
            liqHigh.remove(iH)
    iH -= 1

iL = liqLow.size() - 1
while iL >= 0
    LiqLevel lvl = liqLow.get(iL)
    if lvl.active
        if low <= lvl.lvl + atr * liqTolATR and low >= lvl.lvl - atr * liqTolATR and close > lvl.lvl and bar_index - lvl.lastTouch > liqLen
            lvl.touches := lvl.touches + 1
            lvl.lastTouch := bar_index
            if lvl.touches >= srMin and not lvl.isSR
                lvl.isSR := true
                if not na(lvl.ln)
                    line.set_color(lvl.ln, supCol)
                    line.set_width(lvl.ln, 2)
                    line.set_style(lvl.ln, line.style_solid)
                if showSRLabel and szLvl != "Oculto" and na(lvl.lb)
                    lvl.lb := label.new(bar_index, lvl.lvl, "SOPORTE " + f_px(lvl.lvl), style=label.style_label_left, color=supCol, textcolor=color.white, size=f_sz(szLvl))
        realSweepLow = low < lvl.lvl - atr * liqTolATR and close > lvl.lvl
        brokeBelowLow = close < lvl.lvl
        if realSweepLow or brokeBelowLow
            if realSweepLow
                sweepBullNow := true
            lvl.active := false
            if not na(lvl.ln)
                line.delete(lvl.ln)
                lvl.ln := na
            if not na(lvl.lb)
                label.delete(lvl.lb)
            liqLow.remove(iL)
    iL -= 1

if showSweepTag and sweepBearNow
    label.new(bar_index, high, "💧", style=label.style_label_down, color=color.new(color.aqua, 40), textcolor=color.white, size=size.tiny)
if showSweepTag and sweepBullNow
    label.new(bar_index, low, "💧", style=label.style_label_up, color=color.new(color.aqua, 40), textcolor=color.white, size=size.tiny)

bars24 = tfSec < 86400 ? math.max(2, math.round(86400 / tfSec)) : 1
h24p = tfSec > 86400 ? na : tfSec == 86400 ? high[1] : ta.highest(high[1], bars24)
l24p = tfSec > 86400 ? na : tfSec == 86400 ? low[1] : ta.lowest(low[1], bars24)
var line h24_ln = na
var line l24_ln = na

sweepH24 = showLiq24 and not na(h24p) and ((high > h24p and close < h24p) or close > h24p)
sweepL24 = showLiq24 and not na(l24p) and ((low < l24p and close > l24p) or close < l24p)

var bool h24Swept = false
var bool l24Swept = false

if sweepH24
    h24Swept := true
if sweepL24
    l24Swept := true

newDay = ta.change(time("D")) != 0
if newDay
    h24Swept := false
    l24Swept := false
    if not na(h24_ln)
        line.delete(h24_ln)
        h24_ln := na
    if not na(l24_ln)
        line.delete(l24_ln)
        l24_ln := na

if showLiq24 and not h24Swept and not na(h24p)
    if not na(h24_ln)
        line.delete(h24_ln)
    h24_ln := f_hLine(h24p, liq24Col, 1, 1)
else
    if not na(h24_ln)
        line.delete(h24_ln)
        h24_ln := na

if showLiq24 and not l24Swept and not na(l24p)
    if not na(l24_ln)
        line.delete(l24_ln)
    l24_ln := f_hLine(l24p, liq24Col, 1, 1)
else
    if not na(l24_ln)
        line.delete(l24_ln)
        l24_ln := na

var label h24_lb = na
var label l24_lb = na
if barstate.islast
    if not na(h24_lb)
        label.delete(h24_lb)
        h24_lb := na
    if not na(l24_lb)
        label.delete(l24_lb)
        l24_lb := na
    if showLiq24 and szLiq != "Oculto" and not h24Swept and not na(h24p)
        h24_lb := label.new(bar_index + colLevels, h24p, (lblIcons ? "🕐 Máx. 24h " : "LIQ 24h ↑ ") + f_px(h24p), style=label.style_label_left, color=color.new(liq24Col, 15), textcolor=color.white, size=f_sz(szLiq), tooltip="Liquidez 24h: el MÁXIMO de las últimas 24 horas que todavía no fue tocado. Ahí hay stops acumulados y el precio suele ir a 'barrerlo'. Solo es informativo.")
    if showLiq24 and szLiq != "Oculto" and not l24Swept and not na(l24p)
        l24_lb := label.new(bar_index + colLevels, l24p, (lblIcons ? "🕐 Mín. 24h " : "LIQ 24h ↓ ") + f_px(l24p), style=label.style_label_left, color=color.new(liq24Col, 15), textcolor=color.white, size=f_sz(szLiq), tooltip="Liquidez 24h: el MÍNIMO de las últimas 24 horas que todavía no fue tocado. Ahí hay stops acumulados y el precio suele ir a 'barrerlo'. Solo es informativo.")

float nearHigh = na
if liqHigh.size() > 0
    for idx = 0 to liqHigh.size() - 1
        LiqLevel lv = liqHigh.get(idx)
        if lv.active and lv.lvl > close and (na(nearHigh) or lv.lvl < nearHigh)
            nearHigh := lv.lvl
if showLiq24 and not h24Swept and not na(h24p) and h24p > close and (na(nearHigh) or h24p < nearHigh)
    nearHigh := h24p

float nearLow = na
if liqLow.size() > 0
    for idx = 0 to liqLow.size() - 1
        LiqLevel lv = liqLow.get(idx)
        if lv.active and lv.lvl < close and (na(nearLow) or lv.lvl > nearLow)
            nearLow := lv.lvl
if showLiq24 and not l24Swept and not na(l24p) and l24p < close and (na(nearLow) or l24p > nearLow)
    nearLow := l24p

var label posShortTag = na
var label posLongTag = na
if barstate.islast
    if not na(posShortTag)
        label.delete(posShortTag)
        posShortTag := na
    if not na(posLongTag)
        label.delete(posLongTag)
        posLongTag := na
    if liqHint and not na(nearHigh) and szPos != "Oculto"
        posShortTag := label.new(bar_index, nearHigh, "POSIBLE SHORT · " + f_px(nearHigh), style=label.style_label_left, color=color.red, textcolor=color.white, size=f_sz(szPos))
    if liqHint and not na(nearLow) and szPos != "Oculto"
        posLongTag := label.new(bar_index, nearLow, "POSIBLE LONG · " + f_px(nearLow), style=label.style_label_left, color=color.green, textcolor=color.white, size=f_sz(szPos))

if barstate.islast
    if liqHigh.size() > 0
        for idx = 0 to liqHigh.size() - 1
            LiqLevel q1 = liqHigh.get(idx)
            bool near1 = f_near(q1.lvl)
            if not na(q1.ln)
                line.set_color(q1.ln, near1 ? (q1.isSR ? resCol : liqCol) : na)
            if not na(q1.lb)
                label.set_x(q1.lb, bar_index + 1)
                label.set_color(q1.lb, near1 ? resCol : na)
                label.set_textcolor(q1.lb, near1 ? color.white : na)
    if liqLow.size() > 0
        for idx = 0 to liqLow.size() - 1
            LiqLevel q2 = liqLow.get(idx)
            bool near2 = f_near(q2.lvl)
            if not na(q2.ln)
                line.set_color(q2.ln, near2 ? (q2.isSR ? supCol : liqCol) : na)
            if not na(q2.lb)
                label.set_x(q2.lb, bar_index + 1)
                label.set_color(q2.lb, near2 ? supCol : na)
                label.set_textcolor(q2.lb, near2 ? color.white : na)

plot(barstate.islast and liqHigh.size() > 0 and f_near(liqHigh.get(0).lvl) ? liqHigh.get(0).lvl : na, "💧 EQH 1", color=color.red, style=plot.style_linebr, linewidth=1)
plot(barstate.islast and liqHigh.size() > 1 and f_near(liqHigh.get(1).lvl) ? liqHigh.get(1).lvl : na, "💧 EQH 2", color=color.new(color.red, 40), style=plot.style_linebr, linewidth=1)
plot(barstate.islast and liqHigh.size() > 2 and f_near(liqHigh.get(2).lvl) ? liqHigh.get(2).lvl : na, "💧 EQH 3", color=color.new(color.red, 60), style=plot.style_linebr, linewidth=1)
plot(barstate.islast and liqHigh.size() > 3 and f_near(liqHigh.get(3).lvl) ? liqHigh.get(3).lvl : na, "💧 EQH 4", color=color.new(color.red, 75), style=plot.style_linebr, linewidth=1)
plot(barstate.islast and liqLow.size() > 0 and f_near(liqLow.get(0).lvl) ? liqLow.get(0).lvl : na, "💧 EQL 1", color=color.green, style=plot.style_linebr, linewidth=1)
plot(barstate.islast and liqLow.size() > 1 and f_near(liqLow.get(1).lvl) ? liqLow.get(1).lvl : na, "💧 EQL 2", color=color.new(color.green, 40), style=plot.style_linebr, linewidth=1)
plot(barstate.islast and liqLow.size() > 2 and f_near(liqLow.get(2).lvl) ? liqLow.get(2).lvl : na, "💧 EQL 3", color=color.new(color.green, 60), style=plot.style_linebr, linewidth=1)
plot(barstate.islast and liqLow.size() > 3 and f_near(liqLow.get(3).lvl) ? liqLow.get(3).lvl : na, "💧 EQL 4", color=color.new(color.green, 75), style=plot.style_linebr, linewidth=1)
plot(barstate.islast and showLiq24 and not h24Swept and not na(h24p) ? h24p : na, "🕐 Liq 24h ↑", color=liq24Col, style=plot.style_linebr, linewidth=1)
plot(barstate.islast and showLiq24 and not l24Swept and not na(l24p) ? l24p : na, "🕐 Liq 24h ↓", color=liq24Col, style=plot.style_linebr, linewidth=1)

// ==================== LIQUIDEZ EXTERNA Y AUTOMÁTICA ====================
var array<float>  pstPx = array.new<float>()
var array<string> pstTp = array.new<string>()
var array<string> pstTx = array.new<string>()
var array<float>  pstAm = array.new<float>()
var array<float>  extPx = array.new<float>()
var array<string> extTp = array.new<string>()
var array<string> extTx = array.new<string>()
var array<float>  extAm = array.new<float>()

if barstate.isfirst and showExt
    array<string> extRows = str.split(extText, "\n")
    for r = 0 to extRows.size() - 1
        string row = str.trim(extRows.get(r))
        if str.length(row) > 0 and not str.startswith(row, "#") and pstPx.size() < 40
            array<string> parts = str.split(row, ";")
            float pxv = str.tonumber(str.replace_all(str.trim(parts.get(0)), ",", "."))
            if not na(pxv)
                string rawTp = parts.size() > 1 ? str.upper(str.replace_all(str.trim(parts.get(1)), " ", "_")) : "NIVEL"
                string tpe = str.contains(rawTp, "LIQ") and str.contains(rawTp, "LONG") ? "LIQ_LONG" : str.contains(rawTp, "LIQ") and str.contains(rawTp, "SHORT") ? "LIQ_SHORT" : str.startswith(rawTp, "SOP") ? "SOPORTE" : str.startswith(rawTp, "RES") ? "RESISTENCIA" : "NIVEL"
                string txt = parts.size() > 2 ? str.trim(parts.get(2)) : ""
                float amv = parts.size() > 3 ? str.tonumber(str.replace_all(str.trim(parts.get(3)), ",", ".")) : na
                pstPx.push(pxv)
                pstTp.push(tpe)
                pstTx.push(txt)
                pstAm.push(amv)
    if pstPx.size() > 0
        for k = 0 to pstPx.size() - 1
            extPx.push(pstPx.get(k))
            extTp.push(pstTp.get(k))
            extTx.push(pstTx.get(k))
            extAm.push(pstAm.get(k))

f_addLv(float px, string tp, string tx, float am) =>
    if not na(px)
        extPx.push(px)
        extTp.push(tp)
        extTx.push(tx)
        extAm.push(am)

f_extName(int i) =>
    string t = extTp.get(i)
    string x = extTx.get(i)
    x != "" ? x : t == "LIQ_LONG" ? "LIQ LARGOS" : t == "LIQ_SHORT" ? "LIQ CORTOS" : t

f_friendlyLbl(string n) =>
    string r = n == "PDH" ? "📅 Máx. de ayer" : n == "PDL" ? "📅 Mín. de ayer" : n == "PWH" ? "📆 Máx. semana" : n == "PWL" ? "📆 Mín. semana" : n == "PMH" ? "🗓 Máx. mes" : n == "PML" ? "🗓 Mín. mes" : n
    r := str.replace_all(r, "LIQ CORTOS", "⬆💥 Cortos")
    r := str.replace_all(r, "LIQ LARGOS", "⬇💥 Largos")
    r

f_lvlTip(string n) =>
    n == "PDH" ? "Máximo de AYER. Muchos traders ponen sus stops justo encima: el precio suele reaccionar o 'barrer' este nivel." : n == "PDL" ? "Mínimo de AYER. Muchos traders ponen sus stops justo debajo: el precio suele reaccionar o 'barrer' este nivel." : n == "PWH" ? "Máximo de la SEMANA anterior. Nivel importante: aquí suele haber liquidez y reacciones fuertes." : n == "PWL" ? "Mínimo de la SEMANA anterior. Nivel importante: aquí suele haber liquidez y reacciones fuertes." : n == "PMH" ? "Máximo del MES anterior. Nivel de referencia grande." : n == "PML" ? "Mínimo del MES anterior. Nivel de referencia grande." : str.contains(n, "LIQ CORTOS") ? "Zona donde se liquidarían las posiciones SHORT (cortas) con ese apalancamiento. Está ARRIBA del precio: si el precio sube hasta aquí puede acelerar. Es una estimación." : str.contains(n, "LIQ LARGOS") ? "Zona donde se liquidarían las posiciones LONG (largas) con ese apalancamiento. Está ABAJO del precio: si el precio cae hasta aquí puede acelerar. Es una estimación." : ""

// Liquidación externa pegada más cercana a un borde de zona, dentro del alcance (para proteger el SL).
// Solo usa niveles pegados por el usuario; las liquidaciones estimadas no mueven el SL.
f_extLevelNear(float zoneEdge, bool below) =>
    float res = na
    if extPx.size() > 0
        for i = 0 to extPx.size() - 1
            float plv = extPx.get(i)
            string tlv = extTp.get(i)
            if below and tlv == "LIQ_LONG" and plv < zoneEdge and plv >= zoneEdge - atr * extSlRange
                if na(res) or plv > res
                    res := plv
            if not below and tlv == "LIQ_SHORT" and plv > zoneEdge and plv <= zoneEdge + atr * extSlRange
                if na(res) or plv < res
                    res := plv
    res

// Máximos y mínimos de períodos anteriores (cerrados, sin mirar al futuro)
apdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
apdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
apwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
apwl = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_on)
apmh = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_on)
apml = request.security(syminfo.tickerid, "M", low[1], lookahead=barmerge.lookahead_on)
// Máximo y mínimo del período en curso (para saber si el nivel previo ya fue tocado)
cdhV = request.security(syminfo.tickerid, "D", high)
cdlV = request.security(syminfo.tickerid, "D", low)
cwhV = request.security(syminfo.tickerid, "W", high)
cwlV = request.security(syminfo.tickerid, "W", low)
cmhV = request.security(syminfo.tickerid, "M", high)
cmlV = request.security(syminfo.tickerid, "M", low)

// Último swing importante, base de las liquidaciones estimadas
mjH = ta.pivothigh(high, estPivLen, estPivLen)
mjL = ta.pivotlow(low, estPivLen, estPivLen)
var float lastMajH = na
var float lastMajL = na
if not na(mjH)
    lastMajH := mjH
if not na(mjL)
    lastMajL := mjL

// En la última vela se reconstruye la lista: niveles pegados + automáticos
if barstate.islast and showExt
    extPx.clear()
    extTp.clear()
    extTx.clear()
    extAm.clear()
    if pstPx.size() > 0
        for k = 0 to pstPx.size() - 1
            f_addLv(pstPx.get(k), pstTp.get(k), pstTx.get(k), pstAm.get(k))
    if showAuto
        if not hideMitPrev or not (cdhV >= apdh)
            f_addLv(apdh, "PREV", "PDH", na)
        if not hideMitPrev or not (cdlV <= apdl)
            f_addLv(apdl, "PREV", "PDL", na)
        if not hideMitPrev or not (cwhV >= apwh)
            f_addLv(apwh, "PREV", "PWH", na)
        if not hideMitPrev or not (cwlV <= apwl)
            f_addLv(apwl, "PREV", "PWL", na)
        if not hideMitPrev or not (cmhV >= apmh)
            f_addLv(apmh, "PREV", "PMH", na)
        if not hideMitPrev or not (cmlV <= apml)
            f_addLv(apml, "PREV", "PML", na)
    if showEst
        array<int> estLevs = array.from(estLev1, estLev2, estLev3)
        for k = 0 to 2
            int lv = estLevs.get(k)
            if not na(lastMajH)
                float lq = lastMajH * (1 - 1.0 / lv)
                if lq < close
                    f_addLv(lq, "EST_LONG", "LIQ LARGOS ~" + str.tostring(lv) + "x est.", na)
            if not na(lastMajL)
                float sq = lastMajL * (1 + 1.0 / lv)
                if sq > close
                    f_addLv(sq, "EST_SHORT", "LIQ CORTOS ~" + str.tostring(lv) + "x est.", na)

var array<line>  extLines = array.new<line>()
var array<label> extLbls  = array.new<label>()
var array<float> extHf = array.new<float>()
if barstate.islast and showExt
    while extLines.size() > 0
        line.delete(extLines.pop())
    while extLbls.size() > 0
        label.delete(extLbls.pop())
    extHf.clear()
    float extMax = 0.0
    if extAm.size() > 0
        for i = 0 to extAm.size() - 1
            if not na(extAm.get(i))
                extMax := math.max(extMax, extAm.get(i))
    if extPx.size() > 0
        for i = 0 to extPx.size() - 1
            float pe = extPx.get(i)
            if f_near(pe)
                string te = extTp.get(i)
                float ae = extAm.get(i)
                color ce = te == "LIQ_LONG" or te == "EST_LONG" ? extLongCol : te == "LIQ_SHORT" or te == "EST_SHORT" ? extShortCol : te == "SOPORTE" ? supCol : te == "RESISTENCIA" ? resCol : te == "PREV" ? color.new(color.silver, 10) : color.new(color.white, 20)
                int we = extMax > 0 and not na(ae) ? 1 + math.round(ae / extMax * 3) : 1
                int sty = te == "LIQ_LONG" or te == "LIQ_SHORT" ? 1 : te == "EST_LONG" or te == "EST_SHORT" or te == "PREV" ? 2 : 0
                extLines.push(f_hLine(pe, ce, we, sty))
                string szX = te == "PREV" ? szLvl : szLiq
                if szX != "Oculto"
                    string nmE = f_extName(i)
                    if lblShort
                        nmE := str.replace_all(str.replace_all(nmE, " est.", ""), "~", "")
                    string tipE = f_lvlTip(f_extName(i))
                    if lblIcons
                        nmE := f_friendlyLbl(nmE)
                    extLbls.push(label.new(bar_index + 1, pe, nmE + " " + f_px(pe) + (na(ae) ? "" : " · " + str.tostring(ae, "#.#") + "M"), style=label.style_label_left, color=color.new(ce, 15), textcolor=te == "LIQ_LONG" or te == "EST_LONG" or te == "PREV" ? color.black : color.white, size=f_sz(szX), tooltip=tipE))
                    extHf.push(f_hf(szX))

// Más cercana por encima y por debajo del precio (para el panel), solo entre las visibles
int extUpIdx = -1
int extDnIdx = -1
if barstate.islast and showExt and extPx.size() > 0
    float dUp = 1000000000.0
    float dDn = 1000000000.0
    for i = 0 to extPx.size() - 1
        float pq = extPx.get(i)
        if pq > close and pq - close < dUp and f_near(pq)
            dUp := pq - close
            extUpIdx := i
        if pq <= close and close - pq < dDn and f_near(pq)
            dDn := close - pq
            extDnIdx := i

// El precio tocó algún nivel (alerta)
bool extTouch = false
if showExt and extPx.size() > 0
    for i = 0 to extPx.size() - 1
        float pt = extPx.get(i)
        if low <= pt and high >= pt
            extTouch := true

bsSweepBull = ta.barssince(sweepBullNow)
bsSweepBear = ta.barssince(sweepBearNow)
sweepBullRec = not na(bsSweepBull) and bsSweepBull <= 10
sweepBearRec = not na(bsSweepBear) and bsSweepBear <= 10
sweepOKBull = not requireSweep or sweepBullRec
sweepOKBear = not requireSweep or sweepBearRec

type OB
    box bx
    float top
    float bot
    bool bull
    bool breaker
    bool mit
    bool inst
    label tag
    label brTag
    float rvol
    string strength
    int mergeCount
    float maxFill
    float vol
    float delta
    bool swing
    bool pbDone
    float disp
    int visits
    bool wasIn
    int born

var array<OB> obs = array.new<OB>()

type FZ
    box bx
    float top
    float bot
    bool bull
    bool mit
    float rvol
    string strength
    float maxFill
    float vol
    float delta
    bool touched
    int born

var array<FZ> fzs = array.new<FZ>()

// Parte de la zona que sigue sin tocar (recorta lo ya consumido por el precio)
f_obTopV(OB o) => (not shrinkMit or o.breaker or not o.bull) ? o.top : o.top - o.maxFill / 100 * (o.top - o.bot)
f_obBotV(OB o) => (not shrinkMit or o.breaker or o.bull) ? o.bot : o.bot + o.maxFill / 100 * (o.top - o.bot)
f_fzTopV(FZ f) => (not shrinkMit or not f.bull) ? f.top : f.top - f.maxFill / 100 * (f.top - f.bot)
f_fzBotV(FZ f) => (not shrinkMit or f.bull) ? f.bot : f.bot + f.maxFill / 100 * (f.top - f.bot)

f_clamp100(float x) => math.max(0.0, math.min(100.0, x))

f_legDisp(int n, bool bull) =>
    float bestBody = 0.0
    for k = 0 to n - 1
        float body = bull ? close[k] - open[k] : open[k] - close[k]
        bestBody := math.max(bestBody, body)
    atr > 0 ? bestBody / atr : 0.0

f_hasFvg(OB o) =>
    bool res = false
    if fzs.size() > 0
        for i = 0 to fzs.size() - 1
            FZ f = fzs.get(i)
            if f.bull == o.bull and f.top >= o.bot and f.bot <= o.top
                res := true
    res

f_obScore(OB o) =>
    float aligned = o.bull ? o.delta : -o.delta
    float cOF = f_clamp100(aligned * 2)
    float cDS = f_clamp100(o.disp / 1.25 * 100)
    float cFR = f_clamp100(f_integ(o.maxFill) * math.max(0.0, 1.0 - 0.1 * o.visits))
    float cRV = f_clamp100(o.rvol / 2.2 * 100)
    float cFV = f_hasFvg(o) ? 100.0 : 0.0
    float sc = cOF * 0.35 + cDS * 0.15 + cFR * 0.20 + cRV * 0.20 + cFV * 0.10
    [sc, cOF, cDS, cFR, cRV, cFV]

f_obStrengthTxt(OB o) =>
    [sc, a1, a2, a3, a4, a5] = f_obScore(o)
    sc >= scoreStrong ? "FUERTE" : sc >= scoreMod ? "MODERADO" : "DÉBIL"

f_obTip(OB o) =>
    [sc, cOF, cDS, cFR, cRV, cFV] = f_obScore(o)
    string q = sc >= scoreStrong ? "FUERTE" : sc >= scoreMod ? "MODERADO" : "DÉBIL"
    string dq = o.disp >= 1.25 ? "FUERTE" : o.disp >= 0.75 ? "MODERADO" : "DÉBIL"
    string title = o.breaker ? "ANÁLISIS DEL BREAKER (ex-" + (o.bull ? "soporte" : "resistencia") + ")" : "ANÁLISIS DEL ORDER BLOCK"
    string rd = sc >= scoreStrong ? "Configuración sólida. El rechazo cuenta con buen respaldo estructural y de volumen." : sc >= scoreMod ? "Configuración intermedia. Conviene esperar confirmación en una temporalidad menor." : "Configuración deteriorada o de baja calidad. El rechazo presenta menor respaldo estructural."
    string warn = (o.bull ? o.delta <= -domTh : o.delta >= domTh) ? "\nAdvertencia: la dominancia es contraria a la dirección de la zona." : ""
    string t1 = title + "\nDirección: " + (o.bull ? "ALCISTA" : "BAJISTA") + "\nOrigen: " + (o.swing ? "Swing" : "Interno") + "\nCalidad de rechazo: " + q + "\nScore: " + str.tostring(sc, "#") + "/100"
    string t2 = "\n\nFORMACIÓN\nVolumen: " + f_volFmt(o.vol) + " " + syminfo.currency + "\nRVOL: " + str.tostring(o.rvol, "#.##") + "X\nDelta estimado: " + (o.delta >= 0 ? "+" : "") + str.tostring(o.delta, "#.#") + "%\nDominancia: " + f_dom(o.delta) + "\nDesplazamiento: " + str.tostring(o.disp, "#.##") + " ATR | " + dq + "\nFVG asociado: " + (f_hasFvg(o) ? "SÍ" : "NO")
    string t3 = "\n\nESTADO\nDisponible: " + str.tostring(f_integ(o.maxFill), "#") + "%\nConsumido: " + str.tostring(o.maxFill, "#") + "%\nVisitas acumuladas: " + str.tostring(o.visits)
    string t4 = "\n\nCOMPONENTES DEL SCORE\nOrder Flow: " + str.tostring(cOF, "#") + "/100\nDesplazamiento: " + str.tostring(cDS, "#") + "/100\nFrescura: " + str.tostring(cFR, "#") + "/100\nRVOL: " + str.tostring(cRV, "#") + "/100\nFVG: " + str.tostring(cFV, "#") + "/100\nNota: El score mide calidad de configuración, no probabilidad de éxito."
    t1 + t2 + t3 + t4 + "\n\nLECTURA\n" + rd + warn

f_fzTip(FZ f) =>
    float integ = f_integ(f.maxFill)
    string rd = integ >= 75 ? "Gap casi intacto: zona de liquidez con alta concentración de órdenes. Vigila la reacción del precio en una temporalidad menor." : integ >= 40 ? "Gap parcialmente rellenado: queda menos liquidez pendiente. Úsalo solo como confluencia." : "Gap casi consumido: poca liquidez restante."
    string t1 = "ANÁLISIS DEL FVG\nDirección: " + (f.bull ? "ALCISTA" : "BAJISTA") + "\nCalidad: " + f.strength
    string t2 = "\n\nFORMACIÓN\nVolumen: " + f_volFmt(f.vol) + " " + syminfo.currency + "\nRVOL: " + str.tostring(f.rvol, "#.##") + "X\nDelta estimado: " + (f.delta >= 0 ? "+" : "") + str.tostring(f.delta, "#.#") + "%\nDominancia: " + f_dom(f.delta)
    string t3 = "\n\nESTADO\nDisponible: " + str.tostring(integ, "#") + "%\nConsumido: " + str.tostring(f.maxFill, "#") + "%"
    t1 + t2 + t3 + "\n\nLECTURA\n" + rd

f_obOne(OB o) =>
    "• " + (o.swing ? "SWING " : "") + (o.breaker ? "BREAKER " : "OB ") + (o.bull ? "ALCISTA" : "BAJISTA") + " | " + o.strength + " | VOL " + f_volFmt(o.vol) + " | Δ " + (o.delta >= 0 ? "+" : "") + str.tostring(o.delta, "#") + "% | " + pctMode + " " + str.tostring(f_integ(o.maxFill), "#") + "%"

f_fzOne(FZ f) =>
    "• FVG " + (f.bull ? "ALCISTA" : "BAJISTA") + " | " + f.strength + " | VOL " + f_volFmt(f.vol) + " | Δ " + (f.delta >= 0 ? "+" : "") + str.tostring(f.delta, "#") + "% | " + pctMode + " " + str.tostring(f_integ(f.maxFill), "#") + "%"

f_obText(OB o) =>
    l1 = o.breaker ? ("BREAKER (ex-" + (o.bull ? "soporte" : "resistencia") + ") | " + (o.bull ? "RESISTENCIA" : "SOPORTE")) : ((o.swing ? "SWING " : "") + (o.mergeCount > 1 ? "ZONA " : "") + (o.bull ? "OB ALCISTA" : "OB BAJISTA") + (o.mergeCount > 1 ? " x" + str.tostring(o.mergeCount) : "") + " | " + o.strength)
    l2 = "VOL " + f_volFmt(o.vol) + " " + syminfo.currency + " | RVOL " + str.tostring(o.rvol, "#.##") + "X"
    l3 = "Δ " + (o.delta >= 0 ? "+" : "") + str.tostring(o.delta, "#.#") + "%" + (showDom and not o.breaker ? " | DOM. " + f_dom(o.delta) : "") + " | " + pctMode + " " + str.tostring(f_integ(o.maxFill), "#") + "%"
    string dRow = o.delta >= 0 ? "+" : ""
    l1s = o.breaker ? ("ZONA ROTA · ahora " + (o.bull ? "RESISTENCIA" : "SOPORTE")) : ((o.swing ? "SWING " : "") + (o.bull ? "ZONA DE COMPRA (OB)" : "ZONA DE VENTA (OB)") + (o.mergeCount > 1 ? " ×" + str.tostring(o.mergeCount) : "") + " · " + o.strength)
    l2s = (o.delta >= 0 ? "▲ " : "▼ ") + f_domShort(o.delta) + " " + dRow + str.tostring(o.delta, "#") + "% · " + pctMode + " " + str.tostring(f_integ(o.maxFill), "#") + "%"
    cardSimple ? l1s + "\n" + l2s : l1 + "\n" + l2 + "\n" + l3

if bosUp
    best = 0.0
    bestI = 1
    legUp = obLegOnly and not na(lPLb) ? math.max(1, math.min(lookback, bar_index - lPLb)) : math.max(1, math.min(lookback, bar_index))
    for i = 1 to legUp
        d = open[i] - close[i]
        if d > best
            best := d
            bestI := i
    if best > 0 and (not useATRFilter or best >= atr[bestI] * minATRMult)
        inst = volume[bestI] > vMA[bestI] * whaleMult
        rvolVal = vMA[bestI] != 0 ? volume[bestI] / vMA[bestI] : 0.0
        strengthTxt = rvolVal >= rvolFuerte ? "FUERTE" : rvolVal >= rvolModerado ? "MODERADO" : "DÉBIL"
        volVal = volume[bestI] * hlc3[bestI]
        deltaVal = f_legDelta(bestI)
        dispVal = f_legDisp(bestI, open[bestI] > close[bestI])
        newTop = open[bestI]
        newBot = close[bestI]
        mergeIdx = -1
        if obs.size() > 0
            for mi = 0 to obs.size() - 1
                OB mob = obs.get(mi)
                if not mob.mit and not mob.breaker and mob.bull and mob.top >= newBot and mob.bot <= newTop
                    mergeIdx := mi
                    break
        if mergeIdx >= 0
            OB mob = obs.get(mergeIdx)
            mob.top := math.max(mob.top, newTop)
            mob.bot := math.min(mob.bot, newBot)
            mob.mergeCount := mob.mergeCount + 1
            mob.swing := mob.swing or (bar_index - (mob.bull ? lastBigUp : lastBigDn) <= 2)
            mob.disp := math.max(mob.disp, dispVal)
            mob.maxFill := 0.0
            if inst
                mob.inst := true
            if rvolVal > mob.rvol
                mob.rvol := rvolVal
                mob.strength := strengthTxt
                mob.vol := volVal
                mob.delta := deltaVal
            if not na(mob.bx)
                box.set_top(mob.bx, mob.top)
                box.set_bottom(mob.bx, mob.bot)
                box.set_bgcolor(mob.bx, showZoneInfoBox ? f_strengthCol(mob.strength, true, mob.inst and instBorder ? 75 : 90) : bullOBcol)
        else if rvolVal >= obMinRvol
            instTransBull = inst and instBorder ? 75 : 90
            obs.push(OB.new(showOB ? box.new(bar_index - bestI, open[bestI], extendUntilMit ? bar_index + 1 : bar_index - bestI + obExtendBars, close[bestI], bgcolor=showZoneInfoBox ? f_strengthCol(strengthTxt, true, instTransBull) : bullOBcol, border_width=0) : na, open[bestI], close[bestI], true, false, false, inst, showOB and showInstTag and inst ? label.new(bar_index - bestI, close[bestI], "🐋", style=label.style_none, textcolor=whaleBuyColor, size=size.tiny) : na, na, rvolVal, strengthTxt, 1, 0.0, volVal, deltaVal, swingUpNow, false, dispVal, 0, false, bar_index))

if bosDn
    best = 0.0
    bestI = 1
    legDn = obLegOnly and not na(lPHb) ? math.max(1, math.min(lookback, bar_index - lPHb)) : math.max(1, math.min(lookback, bar_index))
    for i = 1 to legDn
        d = close[i] - open[i]
        if d > best
            best := d
            bestI := i
    if best > 0 and (not useATRFilter or best >= atr[bestI] * minATRMult)
        inst = volume[bestI] > vMA[bestI] * whaleMult
        rvolVal = vMA[bestI] != 0 ? volume[bestI] / vMA[bestI] : 0.0
        strengthTxt = rvolVal >= rvolFuerte ? "FUERTE" : rvolVal >= rvolModerado ? "MODERADO" : "DÉBIL"
        volVal = volume[bestI] * hlc3[bestI]
        deltaVal = f_legDelta(bestI)
        dispVal = f_legDisp(bestI, open[bestI] > close[bestI])
        newTop = close[bestI]
        newBot = open[bestI]
        mergeIdx = -1
        if obs.size() > 0
            for mi = 0 to obs.size() - 1
                OB mob = obs.get(mi)
                if not mob.mit and not mob.breaker and not mob.bull and mob.top >= newBot and mob.bot <= newTop
                    mergeIdx := mi
                    break
        if mergeIdx >= 0
            OB mob = obs.get(mergeIdx)
            mob.top := math.max(mob.top, newTop)
            mob.bot := math.min(mob.bot, newBot)
            mob.mergeCount := mob.mergeCount + 1
            mob.swing := mob.swing or (bar_index - (mob.bull ? lastBigUp : lastBigDn) <= 2)
            mob.disp := math.max(mob.disp, dispVal)
            mob.maxFill := 0.0
            if inst
                mob.inst := true
            if rvolVal > mob.rvol
                mob.rvol := rvolVal
                mob.strength := strengthTxt
                mob.vol := volVal
                mob.delta := deltaVal
            if not na(mob.bx)
                box.set_top(mob.bx, mob.top)
                box.set_bottom(mob.bx, mob.bot)
                box.set_bgcolor(mob.bx, showZoneInfoBox ? f_strengthCol(mob.strength, false, mob.inst and instBorder ? 75 : 90) : bearOBcol)
        else if rvolVal >= obMinRvol
            instTransBear = inst and instBorder ? 75 : 90
            obs.push(OB.new(showOB ? box.new(bar_index - bestI, close[bestI], extendUntilMit ? bar_index + 1 : bar_index - bestI + obExtendBars, open[bestI], bgcolor=showZoneInfoBox ? f_strengthCol(strengthTxt, false, instTransBear) : bearOBcol, border_width=0) : na, close[bestI], open[bestI], false, false, false, inst, showOB and showInstTag and inst ? label.new(bar_index - bestI, close[bestI], "🐋", style=label.style_none, textcolor=whaleSellColor, size=size.tiny) : na, na, rvolVal, strengthTxt, 1, 0.0, volVal, deltaVal, swingDnNow, false, dispVal, 0, false, bar_index))

bool bullTouch = false
bool bearTouch = false
float bullBot = na
float bearTop = na
bool pbNow = false
var label lastPBLbl = na

iOB = obs.size() - 1
while iOB >= 0
    OB o = obs.get(iOB)
    removed = false
    justBroke = false
    if not o.breaker and bar_index > o.born
        inNow = low <= o.top and high >= o.bot
        if inNow and not o.wasIn
            o.visits := o.visits + 1
        o.wasIn := inNow
    // 1) Breaker: el precio cerró al otro lado de la zona (antes se borraba sin llegar a mostrarse)
    if not o.breaker and showBreakers and (o.bull ? close < o.bot : close > o.top)
        o.breaker := true
        o.mit := false
        justBroke := true
        if not na(o.bx)
            box.set_bgcolor(o.bx, o.bull ? bullBRcol : bearBRcol)
            box.set_border_style(o.bx, line.style_dashed)
            box.set_border_color(o.bx, color.new(o.bull ? color.blue : color.purple, 60))
            box.set_border_width(o.bx, 1)
            if showBRLabel and na(o.brTag)
                o.brTag := label.new(bar_index, o.bull ? o.bot : o.top, "BR", style=label.style_none, textcolor=o.bull ? color.blue : color.purple, size=size.tiny)
    // 2) Toque de la zona (OB: entrada desde su lado; breaker: reentrada desde el lado contrario)
    touched = not justBroke and not o.mit and (o.breaker ? (o.bull ? high >= o.bot : low <= o.top) : (o.bull ? low <= o.top : high >= o.bot))
    if touched
        if o.breaker
            o.mit := true
        else
            if showPB and not pbNow and not o.pbDone
                if not na(lastPBLbl)
                    label.delete(lastPBLbl)
                if o.bull
                    lastPBLbl := label.new(bar_index, o.bot, "PB", style=label.style_label_up, color=color.new(color.teal, 30), textcolor=color.white, size=size.tiny)
                else
                    lastPBLbl := label.new(bar_index, o.top, "PB", style=label.style_label_down, color=color.new(color.red, 30), textcolor=color.white, size=size.tiny)
                pbNow := true
            o.pbDone := true
            strOK = not requireZoneStrength or o.strength != "DÉBIL"
            domOK = not requireDomOK or (o.bull ? o.delta > -domTh : o.delta < domTh)
            rejOK = not requireReject or (o.bull ? (close > open and close >= o.bot) : (close < open and close <= o.top))
            if not strOK or not domOK
                o.mit := true
            else if rejOK
                o.mit := true
                if o.bull and not bullTouch
                    bullTouch := true
                    bullBot := o.bot
                if not o.bull and not bearTouch
                    bearTouch := true
                    bearTop := o.top
    fullyFilled = o.breaker ? (o.bull ? close >= o.top : close <= o.bot) : (o.bull ? close <= o.bot : close >= o.top)
    if fullyFilled and not o.mit
        o.mit := true
    if o.mit and (o.breaker ? (hideMitigated and delBreakers) : (fullyFilled and hideMitigated))
        if not na(o.bx)
            box.delete(o.bx)
        if not na(o.tag)
            label.delete(o.tag)
        if not na(o.brTag)
            label.delete(o.brTag)
        obs.remove(iOB)
        removed := true
    if not removed
        if not o.breaker
            if fullyFilled
                o.maxFill := 100.0
            else
                curFill = o.bull ? (low <= o.top ? math.max(0.0, math.min(100.0, (o.top - low) / (o.top - o.bot) * 100)) : 0.0) : (high >= o.bot ? math.max(0.0, math.min(100.0, (high - o.bot) / (o.top - o.bot) * 100)) : 0.0)
                o.maxFill := math.max(o.maxFill, curFill)
            if scoreStrength
                o.strength := f_obStrengthTxt(o)
            if shrinkMit and not fullyFilled and not na(o.bx)
                if o.bull
                    box.set_top(o.bx, f_obTopV(o))
                else
                    box.set_bottom(o.bx, f_obBotV(o))
        if extendUntilMit and not fullyFilled and not (o.breaker and o.mit) and not na(o.bx)
            box.set_right(o.bx, bar_index + 1)
    iOB -= 1

while obs.size() > maxOBs
    OB old = obs.shift()
    if not na(old.bx)
        box.delete(old.bx)
    if not na(old.tag)
        label.delete(old.tag)
    if not na(old.brTag)
        label.delete(old.brTag)

bullIn = false
bullNear = false
bearIn = false
bearNear = false
curZoneStrength = ""
curZoneRVOL = 0.0
curZoneDom = ""
curZoneInteg = 100.0

if obs.size() > 0
    for idx = 0 to obs.size() - 1
        OB z = obs.get(idx)
        if not z.mit and not z.breaker
            if z.bull
                if close <= z.top and close >= z.bot
                    bullIn := true
                    curZoneStrength := z.strength
                    curZoneRVOL := z.rvol
                    curZoneDom := f_dom(z.delta)
                    curZoneInteg := f_integ(z.maxFill)
                else if close > z.top and (close - z.top) <= atr * nearMult
                    bullNear := true
                    curZoneStrength := z.strength
                    curZoneRVOL := z.rvol
                    curZoneDom := f_dom(z.delta)
                    curZoneInteg := f_integ(z.maxFill)
            else
                if close >= z.bot and close <= z.top
                    bearIn := true
                    curZoneStrength := z.strength
                    curZoneRVOL := z.rvol
                    curZoneDom := f_dom(z.delta)
                    curZoneInteg := f_integ(z.maxFill)
                else if close < z.bot and (z.bot - close) <= atr * nearMult
                    bearNear := true
                    curZoneStrength := z.strength
                    curZoneRVOL := z.rvol
                    curZoneDom := f_dom(z.delta)
                    curZoneInteg := f_integ(z.maxFill)

f_fzText(FZ f) =>
    l1 = (f.bull ? "FVG ALCISTA" : "FVG BAJISTA") + " | " + f.strength
    l2 = "VOL " + f_volFmt(f.vol) + " " + syminfo.currency + " | RVOL " + str.tostring(f.rvol, "#.##") + "X"
    l3 = "Δ " + (f.delta >= 0 ? "+" : "") + str.tostring(f.delta, "#.#") + "%" + (showDom ? " | DOM. " + f_dom(f.delta) : "") + " | " + pctMode + " " + str.tostring(f_integ(f.maxFill), "#") + "%"
    string dRow = f.delta >= 0 ? "+" : ""
    l1s = "VACÍO " + (f.bull ? "ALCISTA" : "BAJISTA") + " (FVG) · " + f.strength
    l2s = (f.delta >= 0 ? "▲ " : "▼ ") + f_domShort(f.delta) + " " + dRow + str.tostring(f.delta, "#") + "% · " + pctMode + " " + str.tostring(f_integ(f.maxFill), "#") + "%"
    cardSimple ? l1s + "\n" + l2s : l1 + "\n" + l2 + "\n" + l3

if showFVG and low > high[2]
    rvolValFB = vMA[1] != 0 ? volume[1] / vMA[1] : 0.0
    strengthTxtFB = rvolValFB >= rvolFuerte ? "FUERTE" : rvolValFB >= rvolModerado ? "MODERADO" : "DÉBIL"
    volValFB = volume[1] * hlc3[1]
    deltaValFB = (high[1] - low[1]) != 0 ? (close[1] - open[1]) / (high[1] - low[1]) * 100 : 0.0
    fzs.push(FZ.new(box.new(bar_index - 2, low, extendUntilMit ? bar_index + 1 : bar_index + obExtendBars, high[2], bgcolor=showZoneInfoBox ? f_strengthCol(strengthTxtFB, true, 93) : fvgBullCol, border_width=0), low, high[2], true, false, rvolValFB, strengthTxtFB, 0.0, volValFB, deltaValFB, false, bar_index))
if showFVG and high < low[2]
    rvolValFB = vMA[1] != 0 ? volume[1] / vMA[1] : 0.0
    strengthTxtFB = rvolValFB >= rvolFuerte ? "FUERTE" : rvolValFB >= rvolModerado ? "MODERADO" : "DÉBIL"
    volValFB = volume[1] * hlc3[1]
    deltaValFB = (high[1] - low[1]) != 0 ? (close[1] - open[1]) / (high[1] - low[1]) * 100 : 0.0
    fzs.push(FZ.new(box.new(bar_index - 2, low[2], extendUntilMit ? bar_index + 1 : bar_index + obExtendBars, high, bgcolor=showZoneInfoBox ? f_strengthCol(strengthTxtFB, false, 93) : fvgBearCol, border_width=0), low[2], high, false, false, rvolValFB, strengthTxtFB, 0.0, volValFB, deltaValFB, false, bar_index))

j = fzs.size() - 1
while j >= 0
    FZ f = fzs.get(j)
    mit = f.bull ? low <= f.bot : high >= f.top
    enterF = f.bull ? low <= f.top : high >= f.bot
    if fvgSignals and enterF and not f.touched and bar_index > f.born
        fStrOK = not requireZoneStrength or f.strength != "DÉBIL"
        fDomOK = not requireDomOK or (f.bull ? f.delta > -domTh : f.delta < domTh)
        fRejOK = not requireReject or (f.bull ? (close > open and close >= f.bot) : (close < open and close <= f.top))
        if not fStrOK or not fDomOK
            f.touched := true
        else if fRejOK
            f.touched := true
            if f.bull and not bullTouch
                bullTouch := true
                bullBot := f.bot
            if not f.bull and not bearTouch
                bearTouch := true
                bearTop := f.top
    if mit and not f.mit
        f.mit := true
        if showPB and not pbNow
            if not na(lastPBLbl)
                label.delete(lastPBLbl)
            if f.bull
                lastPBLbl := label.new(bar_index, f.bot, "PB", style=label.style_label_up, color=color.new(color.teal, 30), textcolor=color.white, size=size.tiny)
            else
                lastPBLbl := label.new(bar_index, f.top, "PB", style=label.style_label_down, color=color.new(color.red, 30), textcolor=color.white, size=size.tiny)
            pbNow := true
        if hideMitigated
            box.delete(f.bx)
            fzs.remove(j)
        else
            box.set_bgcolor(f.bx, color.new(f.bull ? color.teal : color.red, 97))
            box.set_right(f.bx, bar_index)
    if not f.mit and extendUntilMit
        box.set_right(f.bx, bar_index + 1)
    if not f.mit and not na(f.bx)
        curFillF = f.bull ? (low <= f.top ? math.max(0.0, math.min(100.0, (f.top - low) / (f.top - f.bot) * 100)) : 0.0) : (high >= f.bot ? math.max(0.0, math.min(100.0, (high - f.bot) / (f.top - f.bot) * 100)) : 0.0)
        f.maxFill := math.max(f.maxFill, curFillF)
        if shrinkMit
            if f.bull
                box.set_top(f.bx, f_fzTopV(f))
            else
                box.set_bottom(f.bx, f_fzBotV(f))
    j -= 1

while fzs.size() > maxFZs
    FZ old = fzs.shift()
    box.delete(old.bx)

bullFIn = false
bullFNear = false
bearFIn = false
bearFNear = false

if fzs.size() > 0
    for idx = 0 to fzs.size() - 1
        FZ z = fzs.get(idx)
        if not z.mit
            if z.bull
                if close <= z.top and close >= z.bot
                    bullFIn := true
                else if close > z.top and (close - z.top) <= atr * nearMult
                    bullFNear := true
            else
                if close >= z.bot and close <= z.top
                    bearFIn := true
                else if close < z.bot and (z.bot - close) <= atr * nearMult
                    bearFNear := true

// Tarjeta de info: una sola por grupo de zonas cercanas o solapadas (el OB tiene prioridad sobre el FVG).
// Caja de tamaño medio y alejada del precio = texto DENTRO de la caja. Caja chica (el texto no entra), enorme (queda fuera de pantalla y el relleno
// tapa las velas) o pegada al precio (se amontonan velas y etiquetas) = tarjeta a la derecha del precio.
// Las tarjetas laterales se juntan en UNA sola etiqueta (las 2 zonas más cercanas al precio) para no pisarse.
var array<label> infoLbls = array.new<label>()
var array<label> cardIcons = array.new<label>()
var array<float> cardHf = array.new<float>()
if barstate.islast
    while infoLbls.size() > 0
        label.delete(infoLbls.pop())
    while cardIcons.size() > 0
        label.delete(cardIcons.pop())
    cardHf.clear()
    array<float> zMid = array.new<float>()
    array<float> zRv = array.new<float>()
    array<float> zH = array.new<float>()
    array<bool> zIsOB = array.new<bool>()
    array<int> zIdx = array.new<int>()
    array<float> sMid = array.new<float>()
    array<string> sTx = array.new<string>()
    array<color> sCol = array.new<color>()
    array<string> sTip = array.new<string>()
    array<string> sTipOne = array.new<string>()
    array<box> sBx = array.new<box>()
    if obs.size() > 0
        for idx = 0 to obs.size() - 1
            OB zo = obs.get(idx)
            if not na(zo.bx)
                box.set_text(zo.bx, "")
                if zo.breaker
                    box.set_bgcolor(zo.bx, zo.bull ? bullBRcol : bearBRcol)
                else
                    int trZ = f_integ(zo.maxFill) < dimInteg ? 96 : (zo.inst and instBorder ? 75 : 90)
                    box.set_bgcolor(zo.bx, showZoneInfoBox ? f_strengthCol(zo.strength, zo.bull, trZ) : (zo.bull ? bullOBcol : bearOBcol))
                    box.set_border_color(zo.bx, zo.swing ? color.new(zo.bull ? color.green : color.red, 25) : color.new(color.gray, 100))
                    box.set_border_width(zo.bx, zo.swing ? 2 : 0)
                if not (zo.breaker ? (zo.bull ? close >= zo.top : close <= zo.bot) : (zo.bull ? close <= zo.bot : close >= zo.top))
                    zMid.push((f_obTopV(zo) + f_obBotV(zo)) / 2)
                    zRv.push(zo.rvol + 1000.0)
                    zH.push(f_obTopV(zo) - f_obBotV(zo))
                    zIsOB.push(true)
                    zIdx.push(idx)
    if fzs.size() > 0
        for idx = 0 to fzs.size() - 1
            FZ zf = fzs.get(idx)
            if not na(zf.bx)
                box.set_text(zf.bx, showFvgPct ? str.tostring(f_integ(zf.maxFill), "#") + "%" : "")
                box.set_text_color(zf.bx, color.new(color.white, 15))
                box.set_text_size(zf.bx, size.tiny)
                box.set_text_halign(zf.bx, text.align_right)
                box.set_text_valign(zf.bx, text.align_center)
                box.set_bgcolor(zf.bx, showZoneInfoBox ? f_strengthCol(zf.strength, zf.bull, 93) : (zf.bull ? fvgBullCol : fvgBearCol))
                if not zf.mit
                    zMid.push((f_fzTopV(zf) + f_fzBotV(zf)) / 2)
                    zRv.push(zf.rvol)
                    zH.push(f_fzTopV(zf) - f_fzBotV(zf))
                    zIsOB.push(false)
                    zIdx.push(idx)
    nZ = zMid.size()
    if nZ > 0
        array<int> sidx = zMid.sort_indices(order.ascending)
        int startK = 0
        for k = 0 to nZ - 1
            bool brk = k == nZ - 1
            if not brk
                float gapMid = zMid.get(sidx.get(k + 1)) - zMid.get(sidx.get(k))
                float halfH = (zH.get(sidx.get(k)) + zH.get(sidx.get(k + 1))) / 2
                brk := gapMid > atr * clusterATR and gapMid > halfH
            if brk
                int members = k - startK + 1
                int bestM = sidx.get(startK)
                float bestRv = -1.0
                for m = startK to k
                    int ix = sidx.get(m)
                    if zRv.get(ix) > bestRv
                        bestRv := zRv.get(ix)
                        bestM := ix
                string tx = ""
                string tp = ""
                string tpOne = ""
                color cc = color.new(color.gray, 10)
                box bxR = na
                float hgt = 0.0
                float midP = 0.0
                if zIsOB.get(bestM)
                    OB ro = obs.get(zIdx.get(bestM))
                    tx := f_obText(ro)
                    cc := ro.breaker ? color.new(ro.bull ? color.blue : color.purple, 10) : f_strengthCol(ro.strength, ro.bull, 10)
                    bxR := ro.bx
                    hgt := f_obTopV(ro) - f_obBotV(ro)
                    midP := (f_obTopV(ro) + f_obBotV(ro)) / 2
                else
                    FZ rf = fzs.get(zIdx.get(bestM))
                    tx := f_fzText(rf)
                    cc := f_strengthCol(rf.strength, rf.bull, 10)
                    bxR := rf.bx
                    hgt := f_fzTopV(rf) - f_fzBotV(rf)
                    midP := (f_fzTopV(rf) + f_fzBotV(rf)) / 2
                if members > 1
                    tx := "×" + str.tostring(members) + " " + tx
                if showTips
                    tp := zIsOB.get(bestM) ? f_obTip(obs.get(zIdx.get(bestM))) : f_fzTip(fzs.get(zIdx.get(bestM)))
                    tpOne := zIsOB.get(bestM) ? f_obOne(obs.get(zIdx.get(bestM))) : f_fzOne(fzs.get(zIdx.get(bestM)))
                    if members > 1
                        int extraTips = 0
                        for m = startK to k
                            int ixm = sidx.get(m)
                            if ixm != bestM and extraTips < 4
                                tp := tp + (extraTips == 0 ? "\n\nOTRAS ZONAS AGRUPADAS:" : "") + "\n" + (zIsOB.get(ixm) ? f_obOne(obs.get(zIdx.get(ixm))) : f_fzOne(fzs.get(zIdx.get(ixm))))
                                extraTips += 1
                if not cardsSide and hgt >= atr * cardMinATR and hgt <= atr * cardMaxATR and math.abs(midP - close) > atr * cardNearATR
                    if not na(bxR)
                        box.set_bgcolor(bxR, cc)
                        box.set_text(bxR, tx)
                        box.set_text_color(bxR, color.white)
                        box.set_text_size(bxR, size.small)
                        box.set_text_halign(bxR, text.align_right)
                        box.set_text_valign(bxR, text.align_center)
                    if showTips
                        infoLbls.push(label.new(bar_index + 1, midP, "ⓘ", style=label.style_label_left, color=cc, textcolor=color.white, size=size.small, tooltip=tp))
                else
                    sMid.push(midP)
                    sTx.push(tx)
                    sCol.push(cc)
                    sTip.push(tp)
                    sTipOne.push(tpOne)
                    sBx.push(bxR)
                startK := k + 1
    nS = sMid.size()
    if nS > 0 and cardsSide
        array<float> sDist = array.new<float>()
        for qq = 0 to nS - 1
            sDist.push(math.abs(sMid.get(qq) - close))
        array<int> dOrd = sDist.sort_indices(order.ascending)
        for rr = 0 to nS - 1
            int qi = dOrd.get(rr)
            if rr < maxSideCards
                bool cardHide = szCard == "Oculto"
                string szC = cardHide ? "Pequeño" : szCard
                infoLbls.push(label.new(bar_index + colCards, sMid.get(qi), cardHide ? "ⓘ" : sTx.get(qi), style=label.style_label_left, color=sCol.get(qi), textcolor=color.white, size=f_sz(szC), tooltip=showTips ? sTip.get(qi) : ""))
                cardHf.push(f_hf(szC))
                cardIcons.push(cardHide ? label(na) : label.new(bar_index + colCards - 2, sMid.get(qi), "ⓘ", style=label.style_label_left, color=sCol.get(qi), textcolor=color.white, size=f_sz(szC), tooltip=showTips ? sTip.get(qi) : ""))
                if not na(sBx.get(qi))
                    box.set_right(sBx.get(qi), bar_index + colCards + cardW)
            else if showTips
                infoLbls.push(label.new(bar_index + colCards, sMid.get(qi), "ⓘ", style=label.style_label_left, color=sCol.get(qi), textcolor=color.white, size=size.small, tooltip=sTip.get(qi)))
                cardHf.push(1.0)
                cardIcons.push(label(na))
    if nS > 0 and not cardsSide
        int i1 = 0
        float d1 = math.abs(sMid.get(0) - close)
        for q = 0 to nS - 1
            float dq1 = math.abs(sMid.get(q) - close)
            if dq1 < d1
                d1 := dq1
                i1 := q
        string txS = sTx.get(i1)
        string tipS = sTip.get(i1)
        if nS > 1
            int i2 = -1
            float d2 = 1000000000.0
            for q = 0 to nS - 1
                if q != i1
                    float dq2 = math.abs(sMid.get(q) - close)
                    if dq2 < d2
                        d2 := dq2
                        i2 := q
            if i2 >= 0
                txS := txS + "\n――――――――――\n" + sTx.get(i2)
                tipS := tipS + "\n\nSIGUIENTE ZONA:\n" + sTipOne.get(i2)
        infoLbls.push(label.new(bar_index + infoLblOffset, sMid.get(i1), txS, style=label.style_label_left, color=sCol.get(i1), textcolor=color.white, size=size.small, tooltip=showTips ? tipS : ""))

inAsia = not na(time(timeframe.period, sessAsia, tz))
inLDN  = not na(time(timeframe.period, sessLDN, tz))
inNYs  = not na(time(timeframe.period, sessNY, tz))
sessOK = not useSessFilter or (allowAsia and inAsia) or (allowLDN and inLDN) or (allowNY and inNYs)

var float aMax = na
var float aMin = na
var int aBar = na
var float ldMax = na
var float ldMin = na
var int ldBar = na
var float nMax = na
var float nMin = na
var int nBar = na
var line aMaxL = na
var line aMinL = na
var line ldMaxL = na
var line ldMinL = na
var line nMaxL = na
var line nMinL = na
var label aMaxT = na
var label aMinT = na
var label ldMaxT = na
var label ldMinT = na
var label nMaxT = na
var label nMinT = na

f_line(int x, float y, color col) =>
    line.new(x, y, bar_index + 2, y, color=col, style=line.style_dashed, width=1)

f_lbl(float y, string txt, color col, bool above) =>
    label.new(bar_index - 2, y, txt, style=above ? label.style_label_down : label.style_label_up, color=col, textcolor=color.white, size=lblSize)

if inAsia and not inAsia[1]
    aMax := high
    aMin := low
    aBar := bar_index
if inAsia
    aMax := math.max(aMax, high)
    aMin := math.min(aMin, low)
if not inAsia and inAsia[1] and showSessLevels
    if not na(aMaxL)
        line.delete(aMaxL)
        label.delete(aMaxT)
        line.delete(aMinL)
        label.delete(aMinT)
    aMaxL := f_line(aBar, aMax, asiaCol)
    aMaxT := f_lbl(aMax, "Asia Máx", asiaCol, true)
    aMinL := f_line(aBar, aMin, asiaCol)
    aMinT := f_lbl(aMin, "Asia Mín", asiaCol, false)

if inLDN and not inLDN[1]
    ldMax := high
    ldMin := low
    ldBar := bar_index
if inLDN
    ldMax := math.max(ldMax, high)
    ldMin := math.min(ldMin, low)
if not inLDN and inLDN[1] and showSessLevels
    if not na(ldMaxL)
        line.delete(ldMaxL)
        label.delete(ldMaxT)
        line.delete(ldMinL)
        label.delete(ldMinT)
    ldMaxL := f_line(ldBar, ldMax, ldnCol)
    ldMaxT := f_lbl(ldMax, "Londres Máx", ldnCol, true)
    ldMinL := f_line(ldBar, ldMin, ldnCol)
    ldMinT := f_lbl(ldMin, "Londres Mín", ldnCol, false)

if inNYs and not inNYs[1]
    nMax := high
    nMin := low
    nBar := bar_index
if inNYs
    nMax := math.max(nMax, high)
    nMin := math.min(nMin, low)
if not inNYs and inNYs[1] and showSessLevels
    if not na(nMaxL)
        line.delete(nMaxL)
        label.delete(nMaxT)
        line.delete(nMinL)
        label.delete(nMinT)
    nMaxL := f_line(nBar, nMax, nyCol)
    nMaxT := f_lbl(nMax, "NY Máx", nyCol, true)
    nMinL := f_line(nBar, nMin, nyCol)
    nMinT := f_lbl(nMin, "NY Mín", nyCol, false)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
plot(showPDH ? pdh : na, "MÁX. ANTERIOR", color=color.new(color.white, 30), linewidth=1, style=plot.style_linebr)
plot(showPDL ? pdl : na, "MÍN. ANTERIOR", color=color.new(color.white, 30), linewidth=1, style=plot.style_linebr)

var label pdhT = na
var label pdlT = na
if showPDH and not mobileMode and newDay and szLvl != "Oculto"
    if not na(pdhT)
        label.delete(pdhT)
    pdhT := label.new(bar_index, pdh, "MÁX. ANTERIOR", style=label.style_label_left, color=color.new(color.black, 40), textcolor=color.white, size=f_sz(szLvl))

if showPDL and not mobileMode and newDay and szLvl != "Oculto"
    if not na(pdlT)
        label.delete(pdlT)
    pdlT := label.new(bar_index, pdl, "MÍN. ANTERIOR", style=label.style_label_left, color=color.new(color.black, 40), textcolor=color.white, size=f_sz(szLvl))

eq = (lPH + lPL) / 2
plot(showEQ ? eq : na, "Equilibrium", color.new(color.white, 55), 1, plot.style_linebr)
plot(showRotura ? lPH : na, "Rotura Long (gatillo)", color.new(color.green, 30), 1, plot.style_linebr)
plot(showRotura ? lPL : na, "Rotura Short (gatillo)", color.new(color.red, 30), 1, plot.style_linebr)

whale = volume > vMA * whaleMult
whaleBuy = whale and close > open
whaleSell = whale and close < open
bsWhaleBuy = ta.barssince(whaleBuy)
bsWhaleSell = ta.barssince(whaleSell)
whaleBuyRec = not na(bsWhaleBuy) and bsWhaleBuy <= whaleLookback
whaleSellRec = not na(bsWhaleSell) and bsWhaleSell <= whaleLookback
barcolor(showWhales and whaleBuy ? whaleBuyColor : na, title="Ballena alcista (amarillo fluor)")
barcolor(showWhales and whaleSell ? whaleSellColor : na, title="Ballena bajista (fucsia)")

setupBullA = (bullIn or bullNear or bullFIn or bullFNear) and whaleBuyRec
setupBearA = (bearIn or bearNear or bearFIn or bearFNear) and whaleSellRec

var int tDir = 0
var int tStage = 0
var float tEntry = na
var float tRisk = na
var float tTP = na
var float tTP2 = na
var float tTP3 = na
var float tSL = na
var bool tBE = false
var bool tOpen = false
var line lEntry = na
var line lTP = na
var line lSL = na
var label lbE = na
var label lbT = na
var label lbS = na
var label lbSig = na
var box bRisk = na
var box bRew = na
var int sSig = 0
var int sTP1 = 0
var int sTP2 = 0
var int sTP3 = 0
var int sSL = 0
var int sBE = 0
var int tBar = -1
var float sCostR = 0.0

// Conexión con el oscilador: puntaje mínimo y, opcionalmente, señal reciente en la misma dirección
linkValid = not na(srcOscSig) and not na(srcOscScoreL) and not na(srcOscScoreS) and srcOscScoreL >= 0 and srcOscScoreL <= 100 and srcOscScoreS >= 0 and srcOscScoreS <= 100 and (srcOscSig == 1 or srcOscSig == -1 or srcOscSig == 0)
bsOscL = ta.barssince(srcOscSig == 1)
bsOscS = ta.barssince(srcOscSig == -1)
oscSigRecL = not na(bsOscL) and bsOscL <= linkWindow
oscSigRecS = not na(bsOscS) and bsOscS <= linkWindow
linkActive = useOscLink and linkValid
linkLongOK  = not linkActive or (srcOscScoreL >= minLinkScore and (not requireOscSig or oscSigRecL))
linkShortOK = not linkActive or (srcOscScoreS >= minLinkScore and (not requireOscSig or oscSigRecS))

bullSig = tDir == 0 and bullTouch and (not useCombined or linkActive or oscOS) and exhBullOK and adxOK and htfBullOK and ctxLongOK and sweepOKBull and sessOK and linkLongOK
bearSig = tDir == 0 and bearTouch and (not useCombined or linkActive or oscOB) and exhBearOK and adxOK and htfBearOK and ctxShortOK and sweepOKBear and sessOK and linkShortOK

// Texto simple de los filtros que faltan (máx. 3 motivos)
f_whyTxt(bool op, bool osc, bool exh, bool adx, bool htf, bool ctx, bool swp, bool ses, bool lnk) =>
    array<string> r = array.new<string>()
    if op
        r.push("op. abierta")
    if osc
        r.push("oscilador")
    if exh
        r.push("sin agotamiento")
    if adx
        r.push("ADX débil")
    if htf
        r.push("TF mayor")
    if ctx
        r.push("contexto")
    if swp
        r.push("sin barrido")
    if ses
        r.push("sesión")
    if lnk
        r.push("puntaje osc.")
    int nr = r.size()
    string out = ""
    for i = 0 to math.min(nr, 3) - 1
        out += (i > 0 ? " · " : "") + r.get(i)
    if nr > 3
        out += " +" + str.tostring(nr - 3)
    out

// Por qué una zona tocada no dio señal
string whyBull = ""
string whyBear = ""
if showWhy and bullTouch and not bullSig
    whyBull := f_whyTxt(tDir != 0, useCombined and not linkActive and not oscOS, not exhBullOK, not adxOK, not htfBullOK, not ctxLongOK, not sweepOKBull, not sessOK, not linkLongOK)
if showWhy and bearTouch and not bearSig
    whyBear := f_whyTxt(tDir != 0, useCombined and not linkActive and not oscOB, not exhBearOK, not adxOK, not htfBearOK, not ctxShortOK, not sweepOKBear, not sessOK, not linkShortOK)
var array<label> whyLbls = array.new<label>()
if whyBull != "" and szWhy != "Oculto"
    whyLbls.push(label.new(bar_index, low - atr * 0.5, "LONG ✖ falta:\n" + whyBull, style=label.style_label_up, color=color.new(color.orange, 10), textcolor=color.black, size=f_sz(szWhy), tooltip="Tocó una zona de compra pero NO es señal todavía. Falta cumplir: " + whyBull + " (oscilador = no confirma · ADX débil = tendencia sin fuerza · TF mayor = timeframe mayor en contra · contexto = contexto en contra · sin barrido = falta barrido de liquidez · puntaje osc. = puntaje del oscilador bajo)"))
if whyBear != "" and szWhy != "Oculto"
    whyLbls.push(label.new(bar_index, high + atr * 0.5, "SHORT ✖ falta:\n" + whyBear, style=label.style_label_down, color=color.new(color.orange, 10), textcolor=color.black, size=f_sz(szWhy), tooltip="Tocó una zona de venta pero NO es señal todavía. Falta cumplir: " + whyBear + " (oscilador = no confirma · ADX débil = tendencia sin fuerza · TF mayor = timeframe mayor en contra · contexto = contexto en contra · sin barrido = falta barrido de liquidez · puntaje osc. = puntaje del oscilador bajo)"))
while whyLbls.size() > whyKeep
    label.delete(whyLbls.shift())

if bullSig
    tDir := 1
    tBar := bar_index
    tStage := 1
    tEntry := close
    tBE := false
    rawSL = bullBot - atr * slBuffer
    extLq = extUseSL and barstate.isrealtime ? f_extLevelNear(bullBot, true) : na
    if not na(extLq)
        rawSL := math.min(rawSL, extLq - atr * slBuffer)
    tSL := math.min(rawSL, tEntry - atr * minSLatr)
    tRisk := tEntry - tSL
    tTP := tEntry + tRisk * rr
    tTP2 := tEntry + tRisk * tp2R
    tTP3 := tEntry + tRisk * tp3R
    sSig += 1
    sCostR += tRisk > 0 ? tEntry * (feePct + slipPct) / 100 * 2 / tRisk : 0.0
if bearSig
    tDir := -1
    tBar := bar_index
    tStage := 1
    tEntry := close
    tBE := false
    rawSL = bearTop + atr * slBuffer
    extLq = extUseSL and barstate.isrealtime ? f_extLevelNear(bearTop, false) : na
    if not na(extLq)
        rawSL := math.max(rawSL, extLq + atr * slBuffer)
    tSL := math.max(rawSL, tEntry + atr * minSLatr)
    tRisk := tSL - tEntry
    tTP := tEntry - tRisk * rr
    tTP2 := tEntry - tRisk * tp2R
    tTP3 := tEntry - tRisk * tp3R
    sSig += 1
    sCostR += tRisk > 0 ? tEntry * (feePct + slipPct) / 100 * 2 / tRisk : 0.0

if bullSig or bearSig
    tOpen := true

if bullSig or bearSig
    if not na(lbSig)
        label.delete(lbSig)
    if bullSig
        lbSig := label.new(bar_index, low, ctxMark ? (ctxBias == "LONG" ? "LONG ✅" : "LONG ⚠️") : "LONG", style=label.style_label_up, color=color.green, textcolor=color.white, size=mobileMode ? size.tiny : lblSize)
    else
        lbSig := label.new(bar_index, high, ctxMark ? (ctxBias == "SHORT" ? "SHORT ✅" : "SHORT ⚠️") : "SHORT", style=label.style_label_down, color=color.red, textcolor=color.white, size=mobileMode ? size.tiny : lblSize)

if sendBridge and (bullSig or bearSig)
    alert('{"fuente":"OB","lado":"' + (bullSig ? "LONG" : "SHORT") + '","simbolo":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","entrada":' + str.tostring(tEntry, format.mintick) + ',"target":' + str.tostring(tTP, format.mintick) + ',"tp2":' + str.tostring(tTP2, format.mintick) + ',"tp3":' + str.tostring(tTP3, format.mintick) + ',"sl":' + str.tostring(tSL, format.mintick) + ',"rr":' + str.tostring(rr, "#.##") + '}', alert.freq_once_per_bar_close)

if bullSig or bearSig
    if not na(lbE)
        label.delete(lbE)
        label.delete(lbT)
        label.delete(lbS)
    lbE := label.new(bar_index, tEntry, "ENTRADA " + f_px(tEntry), style=label.style_label_left, color=color.gray, textcolor=color.white, size=lblSize)
    lbT := label.new(bar_index, tTP, (useMultiTP ? "TP1 " : "TP ") + f_px(tTP), style=label.style_label_left, color=color.green, textcolor=color.white, size=lblSize)
    lbS := label.new(bar_index, tSL, "SL " + f_px(tSL), style=label.style_label_left, color=color.red, textcolor=color.white, size=lblSize)

if (bullSig or bearSig) and showTradeLines
    if not na(lEntry)
        line.delete(lEntry)
        line.delete(lTP)
        line.delete(lSL)
    lEntry := line.new(bar_index, tEntry, bar_index + 20, tEntry, extend=extend.right, color=color.white, width=1)
    lTP    := line.new(bar_index, tTP, bar_index + 20, tTP, extend=extend.right, color=color.green, width=1)
    lSL    := line.new(bar_index, tSL, bar_index + 20, tSL, extend=extend.right, color=color.red, width=1)

if (bullSig or bearSig) and showTradeZones
    if not na(bRisk)
        box.delete(bRisk)
        box.delete(bRew)
    bRisk := box.new(bar_index, math.max(tEntry, tSL), bar_index + 1, math.min(tEntry, tSL), border_color=color.new(color.red, 60), border_width=1, bgcolor=color.new(color.red, 85))
    bRew  := box.new(bar_index, math.max(tEntry, tTP), bar_index + 1, math.min(tEntry, tTP), border_color=color.new(color.green, 60), border_width=1, bgcolor=color.new(color.teal, 85))

if tDir != 0 and not na(bRisk)
    box.set_right(bRisk, bar_index + 1)
    box.set_right(bRew, bar_index + 1)

if tDir == 1 and bar_index > tBar
    target = useMultiTP ? (tStage >= 3 ? tTP3 : tStage == 2 ? tTP2 : tTP) : tTP
    hitT = high >= target
    hitS = low <= tSL
    if hitT and hitS
        if tStage >= 3 and tSL == tTP
            sTP2 += 1
        else if tStage >= 2 and tSL == tEntry
            sTP1 += 1
        else if tBE
            sBE += 1
        else
            sSL += 1
        tDir := 0
    else if hitT
        if not useMultiTP
            sTP1 += 1
            tDir := 0
        else if tStage == 1
            tStage := 2
            tSL := tEntry
            tBE := true
            if showTradeLines and not na(lSL)
                line.set_y1(lSL, tEntry)
                line.set_y2(lSL, tEntry)
                line.set_y1(lTP, tTP2)
                line.set_y2(lTP, tTP2)
            if not na(lbS)
                label.set_y(lbS, tEntry)
                label.set_text(lbS, "SL→BE " + f_px(tEntry))
            if not na(lbT)
                label.set_y(lbT, tTP2)
                label.set_text(lbT, "TP2 " + f_px(tTP2))
            if not na(bRisk)
                box.set_top(bRisk, tEntry)
                box.set_bottom(bRisk, tEntry)
            if not na(bRew)
                box.set_top(bRew, tTP2)
        else if tStage == 2
            tStage := 3
            tSL := tTP
            if showTradeLines and not na(lSL)
                line.set_y1(lSL, tTP)
                line.set_y2(lSL, tTP)
                line.set_y1(lTP, tTP3)
                line.set_y2(lTP, tTP3)
            if not na(lbS)
                label.set_y(lbS, tTP)
                label.set_text(lbS, "SL→TP1 " + f_px(tTP))
            if not na(lbT)
                label.set_y(lbT, tTP3)
                label.set_text(lbT, "TP3 " + f_px(tTP3))
            if not na(bRew)
                box.set_bottom(bRew, tTP3)
        else
            sTP3 += 1
            tDir := 0
    else if hitS
        if tStage >= 3 and tSL == tTP
            sTP2 += 1
        else if tStage >= 2 and tSL == tEntry
            sTP1 += 1
        else if tBE
            sBE += 1
        else
            sSL += 1
        tDir := 0
    else if enableBE and not tBE and (high - tEntry) >= (tTP - tEntry) * bePct / 100
        tSL := tEntry
        tBE := true
        if showTradeLines and not na(lSL)
            line.set_y1(lSL, tEntry)
            line.set_y2(lSL, tEntry)
        if not na(lbS)
            label.set_y(lbS, tEntry)
            label.set_text(lbS, "SL→BE " + f_px(tEntry))
        if not na(bRisk)
            box.set_top(bRisk, tEntry)
            box.set_bottom(bRisk, tEntry)

if tDir == -1 and bar_index > tBar
    target = useMultiTP ? (tStage >= 3 ? tTP3 : tStage == 2 ? tTP2 : tTP) : tTP
    hitT = low <= target
    hitS = high >= tSL
    if hitT and hitS
        if tStage >= 3 and tSL == tTP
            sTP2 += 1
        else if tStage >= 2 and tSL == tEntry
            sTP1 += 1
        else if tBE
            sBE += 1
        else
            sSL += 1
        tDir := 0
    else if hitT
        if not useMultiTP
            sTP1 += 1
            tDir := 0
        else if tStage == 1
            tStage := 2
            tSL := tEntry
            tBE := true
            if showTradeLines and not na(lSL)
                line.set_y1(lSL, tEntry)
                line.set_y2(lSL, tEntry)
                line.set_y1(lTP, tTP2)
                line.set_y2(lTP, tTP2)
            if not na(lbS)
                label.set_y(lbS, tEntry)
                label.set_text(lbS, "SL→BE " + f_px(tEntry))
            if not na(lbT)
                label.set_y(lbT, tTP2)
                label.set_text(lbT, "TP2 " + f_px(tTP2))
            if not na(bRisk)
                box.set_top(bRisk, tEntry)
                box.set_bottom(bRisk, tEntry)
            if not na(bRew)
                box.set_top(bRew, tTP2)
        else if tStage == 2
            tStage := 3
            tSL := tTP
            if showTradeLines and not na(lSL)
                line.set_y1(lSL, tTP)
                line.set_y2(lSL, tTP)
                line.set_y1(lTP, tTP3)
                line.set_y2(lTP, tTP3)
            if not na(lbS)
                label.set_y(lbS, tTP)
                label.set_text(lbS, "SL→TP1 " + f_px(tTP))
            if not na(lbT)
                label.set_y(lbT, tTP3)
                label.set_text(lbT, "TP3 " + f_px(tTP3))
            if not na(bRew)
                box.set_top(bRew, tTP3)
        else
            sTP3 += 1
            tDir := 0
    else if hitS
        if tStage >= 3 and tSL == tTP
            sTP2 += 1
        else if tStage >= 2 and tSL == tEntry
            sTP1 += 1
        else if tBE
            sBE += 1
        else
            sSL += 1
        tDir := 0
    else if enableBE and not tBE and (tEntry - low) >= (tEntry - tTP) * bePct / 100
        tSL := tEntry
        tBE := true
        if showTradeLines and not na(lSL)
            line.set_y1(lSL, tEntry)
            line.set_y2(lSL, tEntry)
        if not na(lbS)
            label.set_y(lbS, tEntry)
            label.set_text(lbS, "SL→BE " + f_px(tEntry))
        if not na(bRisk)
            box.set_top(bRisk, tEntry)
            box.set_bottom(bRisk, tEntry)

if tDir == 0 and tOpen
    if not na(lEntry)
        line.delete(lEntry)
        line.delete(lTP)
        line.delete(lSL)
        lEntry := na
        lTP := na
        lSL := na
    if not na(lbE)
        label.delete(lbE)
        label.delete(lbT)
        label.delete(lbS)
        lbE := na
        lbT := na
        lbS := na
    if not na(lbSig)
        label.delete(lbSig)
        lbSig := na
    if not na(bRisk)
        box.delete(bRisk)
        box.delete(bRew)
        bRisk := na
        bRew := na
    tOpen := false

if barstate.islast and tDir != 0
    if not na(lbE)
        label.set_x(lbE, bar_index)
    if not na(lbT)
        label.set_x(lbT, bar_index)
    if not na(lbS)
        label.set_x(lbS, bar_index)

posEnum(p) =>
    p == "Arriba Derecha" ? position.top_right : p == "Abajo Derecha" ? position.bottom_right : p == "Arriba Izquierda" ? position.top_left : position.bottom_left

txtSz = mobileMode ? size.tiny : (tblSize == "Pequeño" ? size.tiny : tblSize == "Grande" ? size.normal : size.small)
posEntry = mobileMode ? position.top_right : posEnum(tblPos)
posStats = mobileMode ? position.bottom_right : posEnum(stPos)

tpAct = tStage == 2 ? tTP2 : tStage == 3 ? tTP3 : tTP

// ------------------- EQUILIBRIO + PERFIL DE VOLUMEN -------------------
// Rango del fractal (como el Smart Box del video): con tendencia alcista va del mínimo fuerte (inicio del descuento) al
// máximo actual; con bajista, del máximo fuerte (inicio del premium) al mínimo actual. Usa los pivotes SWING (grandes)
// y, si todavía no hay, los pivotes normales.
var float rgHi = na
var float rgLo = na
var int rgStart = na
var int rgView = na
var bool rgUp = true
if barstate.islast
    bool bigOk = not na(lPHBigb) and not na(lPLBigb)
    rgUp := bigOk ? lastBigUp > lastBigDn : trendUp
    int aB = bigOk ? (rgUp ? lPLBigb : lPHBigb) : (rgUp ? nz(lPLb, bar_index) : nz(lPHb, bar_index))
    if bar_index - aB < 5
        aB := bigOk ? math.min(lPHBigb, lPLBigb) : math.min(nz(lPHb, bar_index), nz(lPLb, bar_index))
    rgStart := math.max(aB, bar_index - 480)
    // Borde izquierdo de lo que se ve en pantalla: los textos centrados de las franjas quedan siempre a la vista
    int visN = 0
    for i = 0 to math.min(bar_index, 480)
        if time[i] < chart.left_visible_bar_time
            break
        visN := i
    rgView := math.max(rgStart, bar_index - visN)
    rgHi := high
    rgLo := low
    for i = 0 to bar_index - rgStart
        rgHi := math.max(rgHi, high[i])
        rgLo := math.min(rgLo, low[i])

var box eqBox = na
if barstate.islast and showEqBox and not na(rgHi) and rgHi > rgLo
    if not na(eqBox)
        box.delete(eqBox)
    float rgEq = (rgHi + rgLo) / 2
    float eqBand = math.max((rgHi - rgLo) * 0.03, atr * 0.15)
    eqBox := box.new(rgView, rgEq + eqBand, bar_index + pdReach, rgEq - eqBand, border_color=color.new(color.gray, 55), bgcolor=color.new(color.gray, 82), text="Equilibrio", text_color=color.new(color.white, 25), text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)

var box pzBox = na
var box dzBox = na
if barstate.islast and showPDZ and not na(rgHi) and rgHi > rgLo
    if not na(pzBox)
        box.delete(pzBox)
    if not na(dzBox)
        box.delete(dzBox)
    float pdZ = (rgHi - rgLo) * pdZonePct / 100
    int pdR = bar_index + pdReach
    pzBox := box.new(rgView, rgHi, pdR, rgHi - pdZ, border_color=color.new(color.red, 55), bgcolor=color.new(color.red, 88), text="Premium (caro)", text_color=color.new(color.white, 5), text_size=size.small, text_halign=text.align_center, text_valign=text.align_bottom)
    dzBox := box.new(rgView, rgLo + pdZ, pdR, rgLo, border_color=color.new(color.green, 55), bgcolor=color.new(color.green, 88), text="Discount (barato)", text_color=color.new(color.white, 5), text_size=size.small, text_halign=text.align_center, text_valign=text.align_top)

// ------------------- FIBONACCI (zona de descuento) -------------------
// Niveles del retroceso del último impulso. Alcista: del máximo hacia el mínimo. Bajista: del mínimo hacia el máximo (espejo).
f_fibPx(float r) =>
    float px = na
    if rgUp
        px := fibLog and rgLo > 0 ? math.exp(math.log(rgHi) - r * (math.log(rgHi) - math.log(rgLo))) : rgHi - r * (rgHi - rgLo)
    else
        px := fibLog and rgLo > 0 ? math.exp(math.log(rgLo) + r * (math.log(rgHi) - math.log(rgLo))) : rgLo + r * (rgHi - rgLo)
    px

var array<line>  fibLines = array.new<line>()
var array<box>   fibBoxes = array.new<box>()
var array<label> fibLbls  = array.new<label>()
var array<float> fibHf    = array.new<float>()
var string fibTxt = "OFF"
var color  fibCol = color.gray
var bool   fibInZone = false
if barstate.islast
    while fibLines.size() > 0
        line.delete(fibLines.pop())
    while fibBoxes.size() > 0
        box.delete(fibBoxes.pop())
    while fibLbls.size() > 0
        label.delete(fibLbls.pop())
    fibHf.clear()
    fibInZone := false
    fibTxt := "OFF"
    fibCol := color.gray
    if showFib and not na(rgHi) and rgHi > rgLo
        float p50 = f_fibPx(0.5)
        float pGa = f_fibPx(fibGpA)
        float pGb = f_fibPx(fibGpB)
        float p786 = f_fibPx(0.786)
        float p382 = f_fibPx(0.382)
        float pEnd = rgUp ? rgLo : rgHi
        float avgE = (p50 + pGa) / 2
        float pBE = rgUp ? avgE * (1 + fibBEpct / 100.0) : avgE * (1 - fibBEpct / 100.0)
        float pTP = rgUp ? rgHi : rgLo
        color cZ = rgUp ? color.green : color.red
        int fx1 = rgView
        int fx2 = bar_index + pdReach
        string who = rgUp ? "DESCUENTO" : "PREMIUM"
        string buy = rgUp ? "compra" : "venta"
        fibBoxes.push(box.new(fx1, math.max(p50, pEnd), fx2, math.min(p50, pEnd), border_width=0, bgcolor=color.new(cZ, 93)))
        fibBoxes.push(box.new(fx1, math.max(pGa, pGb), fx2, math.min(pGa, pGb), border_width=0, bgcolor=color.new(color.yellow, 82)))
        fibLines.push(line.new(fx1, p50, bar_index + colLevels, p50, color=color.new(cZ, 20), style=line.style_solid, width=1))
        fibLines.push(line.new(fx1, pGa, bar_index + colLevels, pGa, color=color.new(color.yellow, 20), style=line.style_dashed, width=1))
        if fibShow786
            fibLines.push(line.new(fx1, p786, bar_index + colLevels, p786, color=color.new(color.gray, 40), style=line.style_dotted, width=1))
        if fibShow382
            fibLines.push(line.new(fx1, p382, bar_index + colLevels, p382, color=color.new(color.gray, 40), style=line.style_dotted, width=1))
        if szFib != "Oculto"
            string tpFx = " · " + (fibLog ? "escala log" : "escala normal")
            fibLbls.push(label.new(bar_index + colLevels, p50, "📐 50% " + who + " · 1ª " + buy + " " + f_px(p50), style=label.style_label_left, color=color.new(cZ, 25), textcolor=color.white, size=f_sz(szFib), tooltip="Fibonacci 50%: el precio devolvió la mitad del último impulso. Es el punto mínimo para empezar a " + (rgUp ? "comprar" : "vender") + " según la estrategia del video" + tpFx + "."))
            fibHf.push(f_hf(szFib))
            fibLbls.push(label.new(bar_index + colLevels, pGa, "📐 Golden Pocket · 2ª " + buy + " " + f_px(pGa), style=label.style_label_left, color=color.new(color.yellow, 20), textcolor=color.black, size=f_sz(szFib), tooltip="Golden pocket (" + str.tostring(fibGpA) + " a " + str.tostring(fibGpB) + "): zona de retroceso profundo donde se busca la segunda " + buy + "."))
            fibHf.push(f_hf(szFib))
            if fibShow786
                fibLbls.push(label.new(bar_index + colLevels, p786, "📐 0.786 " + f_px(p786), style=label.style_label_left, color=color.new(color.gray, 25), textcolor=color.white, size=f_sz(szFib), tooltip="Nivel 0.786: retroceso muy profundo. Si se pierde, el impulso suele estar en riesgo."))
                fibHf.push(f_hf(szFib))
            if fibShow382
                fibLbls.push(label.new(bar_index + colLevels, p382, "📐 0.382 " + f_px(p382), style=label.style_label_left, color=color.new(color.gray, 25), textcolor=color.white, size=f_sz(szFib), tooltip="Nivel 0.382: retroceso leve, todavía no es zona de " + who + "."))
                fibHf.push(f_hf(szFib))
            if fibPlan
                fibLbls.push(label.new(bar_index + colLevels, pBE, "🛡 +" + str.tostring(fibBEpct) + "% → SL a break even " + f_px(pBE), style=label.style_label_left, color=color.new(color.teal, 25), textcolor=color.white, size=f_sz(szFib), tooltip="Plan del video: cuando el precio promedio de entrada se mueve " + str.tostring(fibBEpct) + "% a tu favor, mueve el stop justo por encima del promedio para proteger la entrada. Promedio estimado con 2 compras iguales (50% y golden pocket): " + f_px(avgE) + "."))
                fibHf.push(f_hf(szFib))
                fibLbls.push(label.new(bar_index + colLevels, pTP, "🎯 Salir " + str.tostring(fibTpPart) + "% · " + (rgUp ? "máx." : "mín.") + " anterior " + f_px(pTP), style=label.style_label_left, color=color.new(color.green, 25), textcolor=color.white, size=f_sz(szFib), tooltip="Plan del video: al tomar el " + (rgUp ? "máximo" : "mínimo") + " anterior se cierra una parte de la posición y el resto se deja correr."))
                fibHf.push(f_hf(szFib))
        bool atZone = rgUp ? close <= p50 : close >= p50
        bool atGp = (close <= math.max(pGa, pGb)) and (close >= math.min(pGa, pGb))
        fibInZone := atZone
        float distP = math.abs(close - p50) / close * 100
        fibTxt := atZone ? "📐 En zona de " + who + " (50%+)" + (atGp ? " · Golden Pocket" : "") : "📐 Esperando retroceso · faltan " + str.tostring(distP, "#.#") + "% al 50%"
        fibCol := atGp ? color.yellow : atZone ? cZ : color.gray

var array<box> vpBoxes = array.new<box>()
var array<line> vpLines = array.new<line>()
var label vpPocLbl = na
var float vpPoc = na
var float vpVah = na
var float vpVal = na
if barstate.islast and showVP and not na(rgStart)
    while vpBoxes.size() > 0
        box.delete(vpBoxes.pop())
    while vpLines.size() > 0
        line.delete(vpLines.pop())
    if not na(vpPocLbl)
        label.delete(vpPocLbl)
        vpPocLbl := na
    int vpStart = math.max(rgStart, bar_index - vpMaxBars)
    int vpN = bar_index - vpStart + 1
    float vpHi = high
    float vpLo = low
    for i = 0 to vpN - 1
        vpHi := math.max(vpHi, high[i])
        vpLo := math.min(vpLo, low[i])
    float vpStep = (vpHi - vpLo) / vpRows
    if vpN >= 5 and vpStep > 0
        array<float> rv = array.new_float(vpRows, 0.0)
        array<float> rbuy = array.new_float(vpRows, 0.0)
        for i = 0 to vpN - 1
            float rng = high[i] - low[i]
            float bf = rng > 0 ? (close[i] - low[i]) / rng : 0.5
            int r0 = math.max(0, math.min(vpRows - 1, math.floor((low[i] - vpLo) / vpStep)))
            int r1 = math.max(0, math.min(vpRows - 1, math.floor((high[i] - vpLo) / vpStep)))
            for r = r0 to r1
                float rLo = vpLo + r * vpStep
                float ov = rng > 0 ? math.max(0.0, math.min(high[i], rLo + vpStep) - math.max(low[i], rLo)) / rng : 1.0
                float vv = nz(volume[i]) * ov
                rv.set(r, rv.get(r) + vv)
                rbuy.set(r, rbuy.get(r) + vv * bf)
        float vTot = rv.sum()
        float vMax = rv.max()
        int pocR = rv.indexof(vMax)
        float acc = vMax
        int vaLo = pocR
        int vaHi = pocR
        while acc < vTot * vpVA / 100 and (vaLo > 0 or vaHi < vpRows - 1)
            float vPrev = vaLo > 0 ? rv.get(vaLo - 1) : -1.0
            float vNext = vaHi < vpRows - 1 ? rv.get(vaHi + 1) : -1.0
            if vNext >= vPrev
                vaHi += 1
                acc += vNext
            else
                vaLo -= 1
                acc += vPrev
        int wBars = math.max(3, math.round(vpN * vpWidthPct / 100))
        for r = 0 to vpRows - 1
            float vrow = rv.get(r)
            bool inVA = r >= vaLo and r <= vaHi
            float bShare = vrow > 0 ? rbuy.get(r) / vrow : 0.5
            color cRow = r == pocR ? color.new(color.yellow, 60) : vpDelta ? (bShare >= 0.5 ? color.new(color.teal, inVA ? 68 : 86) : color.new(color.red, inVA ? 68 : 86)) : color.new(color.gray, inVA ? 68 : 86)
            int rowW = math.max(1, math.round(vMax > 0 ? vrow / vMax * (vpRight ? vpWidthBars : wBars) : 0))
            int rowL = vpRight ? bar_index + 1 - rowW : vpStart
            vpBoxes.push(box.new(rowL, vpLo + (r + 1) * vpStep, rowL + rowW, vpLo + r * vpStep, border_width=0, bgcolor=cRow))
        vpPoc := vpLo + (pocR + 0.5) * vpStep
        vpVah := vpLo + (vaHi + 1) * vpStep
        vpVal := vpLo + vaLo * vpStep
        vpLines.push(line.new(vpStart, vpPoc, bar_index + colLevels, vpPoc, color=color.new(color.yellow, 10), style=line.style_dashed, width=1))
        vpLines.push(line.new(vpStart, vpVah, bar_index + 1, vpVah, color=color.new(color.gray, 35), style=line.style_dotted, width=1))
        vpLines.push(line.new(vpStart, vpVal, bar_index + 1, vpVal, color=color.new(color.gray, 35), style=line.style_dotted, width=1))
        if szPoc != "Oculto"
            vpPocLbl := label.new(bar_index + 1, vpPoc, (lblIcons ? "🎯 POC " : "POC ") + f_px(vpPoc), style=label.style_label_left, color=color.new(color.yellow, 15), textcolor=color.black, size=f_sz(szPoc), tooltip="POC: el precio donde más se negoció en el rango. Sobre el POC el mercado está alcista; bajo el POC, bajista. Entre VAL y VAH está la zona de valor (donde se concentró el " + str.tostring(vpVA) + "% del volumen).")

if showEntryPanel and barstate.islast
    var table et = na
    if na(et)
        et := table.new(posEntry, 2, panelCompact ? 7 : 18, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.new(color.gray, 60))
    estado = tDir == 1 ? "LONG ACTIVO" : tDir == -1 ? "SHORT ACTIVO" : "ESPERANDO SEÑAL"
    estCol = tDir == 1 ? color.green : tDir == -1 ? color.red : color.gray
    zonaTxt = (setupBullA ? "🐋 BALLENA + ZONA LONG = A+" : setupBearA ? "🐋 BALLENA + ZONA SHORT = A+" : bullIn ? "🎯 EN OB ALCISTA" : bearIn ? "🎯 EN OB BAJISTA" : bullFIn ? "🎯 EN FVG ALCISTA" : bearFIn ? "🎯 EN FVG BAJISTA" : bullNear ? "⚠ OB ALCISTA CERCA" : bearNear ? "⚠ OB BAJISTA CERCA" : bullFNear ? "⚠ FVG ALCISTA CERCA" : bearFNear ? "⚠ FVG BAJISTA CERCA" : "—") + (showZoneStrength and (bullIn or bearIn or bullNear or bearNear) and curZoneStrength != "" ? " | " + curZoneStrength + " (RVOL " + str.tostring(curZoneRVOL, "#.##") + "x)" : "")
    zonaCol = setupBullA ? whaleBuyColor : setupBearA ? whaleSellColor : bullIn ? color.green : bearIn ? color.red : bullFIn ? color.teal : bearFIn ? color.maroon : bullNear or bearNear or bullFNear or bearFNear ? color.orange : color.gray
    ctxTxt = bullConf ? "🟢 LONG CONFIRMADO" : bearConf ? "🔴 SHORT CONFIRMADO" : diP > diM ? "🟠 LONG SIN CONF. DELTA" : diM > diP ? "🟠 SHORT SIN CONF. DELTA" : "⚪ NEUTRO"
    ctxCol = bullConf ? color.green : bearConf ? color.red : diP > diM or diM > diP ? color.orange : color.gray
    diTxt = str.tostring(diP, "#.##") + " / " + str.tostring(diM, "#.##") + (diM > diP ? " · vendedores" : diP > diM ? " · compradores" : " · equilibrio")
    diCol = diM > diP ? color.red : diP > diM ? color.green : color.gray
    deltaTxtP = (deltaPct >= 0 ? "+" : "") + str.tostring(deltaPct, "#.#") + "% vs 0"
    deltaColP = deltaPct >= 0 ? color.green : color.red

    nhEq = f_hasLevel(liqHigh, nearHigh)
    nh24 = showLiq24 and not h24Swept and not na(h24p) and h24p == nearHigh
    nhSrc = nhEq and nh24 ? "EQH+24h" : nhEq ? "EQH" : nh24 ? "24h" : ""
    nlEq = f_hasLevel(liqLow, nearLow)
    nl24 = showLiq24 and not l24Swept and not na(l24p) and l24p == nearLow
    nlSrc = nlEq and nl24 ? "EQL+24h" : nlEq ? "EQL" : nl24 ? "24h" : ""
    liqHighTxt = na(nearHigh) ? "—" : f_px(nearHigh) + " · " + nhSrc + " · SHORT"
    liqHighCol = na(nearHigh) ? color.gray : color.red
    liqLowTxt = na(nearLow) ? "—" : f_px(nearLow) + " · " + nlSrc + " · LONG"
    liqLowCol = na(nearLow) ? color.gray : color.green
    h24Part = not showLiq24 or na(h24p) ? "Máx —" : h24Swept ? "Máx ✅ absorbida" : "Máx ⏳" + (h24p == nearHigh ? "" : " " + f_px(h24p))
    l24Part = not showLiq24 or na(l24p) ? "Mín —" : l24Swept ? "Mín ✅ absorbida" : "Mín ⏳" + (l24p == nearLow ? "" : " " + f_px(l24p))
    liq24Txt = h24Part + " · " + l24Part
    h24On = showLiq24 and not na(h24p)
    l24On = showLiq24 and not na(l24p)
    liq24Col = not h24On and not l24On ? color.gray : (not h24On or h24Swept) and (not l24On or l24Swept) ? color.green : color.orange
    extUpTxt = not showExt or extPx.size() == 0 or extUpIdx < 0 ? "—" : f_px(extPx.get(extUpIdx)) + " · " + f_extName(extUpIdx) + " · " + str.tostring((extPx.get(extUpIdx) - close) / atr, "#.#") + " ATR"
    extDnTxt = not showExt or extPx.size() == 0 or extDnIdx < 0 ? "—" : f_px(extPx.get(extDnIdx)) + " · " + f_extName(extDnIdx) + " · " + str.tostring((close - extPx.get(extDnIdx)) / atr, "#.#") + " ATR"
    extAllTxt = not showExt or extPx.size() == 0 ? "—" : "↑ " + extUpTxt + "\n↓ " + extDnTxt
    extAllCol = extUpIdx < 0 and extDnIdx < 0 ? color.gray : color.white

    isWeekend = dayofweek(time, tz) == dayofweek.saturday or dayofweek(time, tz) == dayofweek.sunday
    string asTxt = ""
    color asCol = color.gray
    if bullSig or bearSig
        asTxt := "✅ SEÑAL " + (bullSig ? "LONG" : "SHORT") + "\nEntrada " + f_px(tEntry) + " · SL " + f_px(tSL) + " · TP " + f_px(tTP)
        asCol := bullSig ? color.green : color.red
    else if tDir != 0
        asTxt := "📈 Operación " + (tDir == 1 ? "LONG" : "SHORT") + " abierta\nRespeta el SL " + f_px(tSL) + " y no abras otra"
        asCol := tDir == 1 ? color.green : color.red
    else if bullIn or bullFIn or bearIn or bearFIn
        bool asL = bullIn or bullFIn
        string asWhy = asL ? whyBull : whyBear
        asTxt := "👀 En zona de " + (asL ? "COMPRA" : "VENTA") + ": aún no es señal\n" + (asWhy != "" ? "Falta: " + asWhy : "Espera la vela de confirmación")
        asCol := color.yellow
    else if bullNear or bullFNear or bearNear or bearFNear
        asTxt := "⏳ Cerca de una zona de " + (bullNear or bullFNear ? "COMPRA" : "VENTA") + "\nPrepárate, no entres todavía"
        asCol := color.orange
    else
        asTxt := "⏳ Sin zonas cerca\nEspera, no operes por operar"
    if showFib and fibInZone and not (bullSig or bearSig) and tDir == 0
        asTxt += "\n📐 En zona Fibonacci (50%+)"

    int pr = 0
    table.clear(et, 0, 0, 1, (panelCompact ? 7 : 18) - 1)
    pctTP = tDir == 1 ? (tpAct - close) / close * 100 : tDir == -1 ? (close - tpAct) / close * 100 : 0.0
    table.cell(et, 0, pr, "ESTADO", text_color=color.white, text_size=txtSz)
    table.cell(et, 1, pr, estado + (useMultiTP and tDir != 0 ? " → TP" + str.tostring(tStage) + " (falta " + str.tostring(math.abs(pctTP), "#.##") + "%)" : ""), text_color=estCol, text_size=txtSz)
    pr += 1
    if showAssist
        table.cell(et, 0, pr, "🤖 Asistente", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, asTxt, text_color=asCol, text_size=txtSz)
        pr += 1
    if not panelCompact
        table.cell(et, 0, pr, "Ratio", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, str.tostring(rr, "#.#") + ":1" + (rrInput == "Automático" ? " (auto)" : ""), text_color=color.yellow, text_size=txtSz)
        pr += 1
    if not panelCompact
        table.cell(et, 0, pr, "ADX", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, str.tostring(adx, "#") + (adxIsWeak ? " (Débil)" : adxIsStrong ? " (Fuerte)" : " (Media)"), text_color=adxIsWeak ? color.gray : adxIsStrong ? color.green : color.orange, text_size=txtSz)
        pr += 1
    table.cell(et, 0, pr, "Zona", text_color=color.gray, text_size=txtSz)
    table.cell(et, 1, pr, zonaTxt, text_color=zonaCol, text_size=txtSz)
    pr += 1
    if not panelCompact
        table.cell(et, 0, pr, "CTX ADX", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, ctxTxt, text_color=ctxCol, text_size=txtSz)
        pr += 1
    if not panelCompact
        table.cell(et, 0, pr, "DI+ / DI−", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, diTxt, text_color=diCol, text_size=txtSz)
        pr += 1
    if not panelCompact
        table.cell(et, 0, pr, "DELTA", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, deltaTxtP, text_color=deltaColP, text_size=txtSz)
        pr += 1
    if not panelCompact
        table.cell(et, 0, pr, "💧 Liq ↑", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, liqHighTxt, text_color=liqHighCol, text_size=txtSz)
        pr += 1
    if not panelCompact
        table.cell(et, 0, pr, "💧 Liq ↓", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, liqLowTxt, text_color=liqLowCol, text_size=txtSz)
        pr += 1
    if not panelCompact
        table.cell(et, 0, pr, "🕐 Liq 24h", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, liq24Txt, text_color=liq24Col, text_size=txtSz)
        pr += 1
    if not panelCompact
        table.cell(et, 0, pr, "🌊 Liq externa", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, extAllTxt, text_color=extAllCol, text_size=txtSz)
        pr += 1
    domTxtP = curZoneStrength == "" ? "Sin OB cerca" : curZoneDom + " · integridad " + str.tostring(curZoneInteg, "#") + "%"
    domColP = curZoneDom == "COMPRADORES" ? color.green : curZoneDom == "VENDEDORES" ? color.red : color.gray
    if not panelCompact
        table.cell(et, 0, pr, "Dominancia OB", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, domTxtP, text_color=domColP, text_size=txtSz)
        pr += 1
    sessNow = (inAsia ? "Asia " : "") + (inLDN ? "Londres " : "") + (inNYs ? "NY" : "")
    sessTxtP = isWeekend ? "🌙 FIN DE SEMANA · poca liquidez" : not useSessFilter ? "Filtro OFF" + (sessNow != "" ? " · " + sessNow : " · sin sesión activa") : (sessOK ? "✅ " : "⛔ FUERA · ") + (sessNow != "" ? sessNow : "sin sesión")
    sessColP = isWeekend ? color.orange : not useSessFilter ? color.gray : sessOK ? color.green : color.orange
    table.cell(et, 0, pr, "Sesión", text_color=color.gray, text_size=txtSz)
    table.cell(et, 1, pr, sessTxtP, text_color=sessColP, text_size=txtSz)
    pr += 1
    riskUsd = acctSize * riskPct / 100
    qtyP = tDir != 0 and tRisk > 0 ? riskUsd / tRisk : na
    posTxtP = not showPosSize ? "—" : na(qtyP) ? "Riesgo " + str.tostring(riskUsd, "#.##") + " · espera señal" : str.tostring(qtyP, "#.####") + " " + syminfo.basecurrency + " ≈ " + str.tostring(qtyP * tEntry, "#.##") + " " + syminfo.currency + " · riesgo " + str.tostring(riskUsd, "#.##")
    if not panelCompact
        table.cell(et, 0, pr, "Tamaño posición", text_color=color.gray, text_size=txtSz)
        table.cell(et, 1, pr, posTxtP, text_color=color.yellow, text_size=txtSz)
        pr += 1
    linkTxtP = not useOscLink ? "OFF (actívalo en ajustes)" : not linkValid ? "⚠ Selecciona las series del oscilador" : "LONG " + str.tostring(srcOscScoreL, "#") + (linkLongOK ? " ✅" : " ⛔") + " · SHORT " + str.tostring(srcOscScoreS, "#") + (linkShortOK ? " ✅" : " ⛔")
    linkColP = not useOscLink ? color.gray : not linkValid ? color.orange : color.white
    table.cell(et, 0, pr, "🔗 Oscilador", text_color=color.gray, text_size=txtSz)
    table.cell(et, 1, pr, linkTxtP, text_color=linkColP, text_size=txtSz)
    pr += 1
    vpTxtP = not showVP ? "OFF" : na(vpPoc) ? "—" : "POC " + f_px(vpPoc) + (close > vpVah ? " · sobre zona de valor ▲" : close > vpPoc ? " · sobre el POC ▲" : close >= vpVal ? " · bajo el POC ▼" : " · bajo zona de valor ▼")
    vpColP = not showVP or na(vpPoc) ? color.gray : close > vpPoc ? color.green : color.red
    table.cell(et, 0, pr, "📊 Perfil volumen", text_color=color.gray, text_size=txtSz)
    table.cell(et, 1, pr, vpTxtP, text_color=vpColP, text_size=txtSz)
    pr += 1
    table.cell(et, 0, pr, "📐 Fibonacci", text_color=color.gray, text_size=txtSz)
    table.cell(et, 1, pr, showFib ? fibTxt : "OFF", text_color=showFib ? fibCol : color.gray, text_size=txtSz)
    pr += 1

if showStats and barstate.islast
    var table st = na
    if na(st)
        st := table.new(posStats, 1, 5, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.new(color.gray, 60))
    tps = sTP1 + sTP2 + sTP3
    wr = (tps + sSL) > 0 ? tps / (tps + sSL) * 100 : 0.0
    netos = sTP1 * rr + sTP2 * tp2R + sTP3 * tp3R - sSL
    table.cell(st, 0, 0, "Señales: " + str.tostring(sSig), text_color=color.white, text_size=txtSz)
    table.cell(st, 0, 1, "TP1 " + str.tostring(sTP1) + " · TP2 " + str.tostring(sTP2) + " · TP3 " + str.tostring(sTP3), text_color=color.green, text_size=txtSz)
    table.cell(st, 0, 2, "SL " + str.tostring(sSL) + " · BE " + str.tostring(sBE), text_color=color.red, text_size=txtSz)
    table.cell(st, 0, 3, "Winrate: " + str.tostring(wr, "#.#") + "%", text_color=wr >= 50 ? color.green : color.red, text_size=txtSz)
    netosC = netos - sCostR
    table.cell(st, 0, 4, "Netos: " + str.tostring(netosC, "#.#") + " R (costos −" + str.tostring(sCostR, "#.#") + " R)", text_color=netosC >= 0 ? color.green : color.red, text_size=txtSz)

// ------------------- ORDEN FINAL DE ETIQUETAS (derecha) -------------------
// Cada columna se ordena de arriba abajo y se separa en vertical según el alto estimado de su texto,
// así niveles, liquidaciones y tarjetas no se encimen.
var float rowUnitG = na

f_spread(array<label> ls, array<label> comp, array<float> hf, int xOff, int compDx) =>
    int n = ls.size()
    if n > 0
        array<float> ys = array.new<float>()
        for i = 0 to n - 1
            ys.push(label.get_y(ls.get(i)))
        array<int> ord = ys.sort_indices(order.descending)
        float prevBot = na
        for k = 0 to n - 1
            label lbk = ls.get(ord.get(k))
            int rows = array.size(str.split(label.get_text(lbk), "\n"))
            float hh = rowUnitG * rows * (hf.size() == n ? hf.get(ord.get(k)) : 1.0)
            float yy = ys.get(ord.get(k))
            if not na(prevBot) and yy + hh / 2 > prevBot
                yy := prevBot - hh / 2
            label.set_xy(lbk, bar_index + xOff, yy)
            if comp.size() == n
                label lci = comp.get(ord.get(k))
                if not na(lci)
                    label.set_xy(lci, bar_index + xOff + compDx, yy)
            prevBot := yy - hh / 2

if barstate.islast and tidyRight
    if hideMitPrev and not na(pdhT) and cdhV >= pdh
        label.delete(pdhT)
        pdhT := na
    if hideMitPrev and not na(pdlT) and cdlV <= pdl
        label.delete(pdlT)
        pdlT := na
    rowUnitG := rowGapATR * atr
    if tidyAuto
        float visHi = high
        float visLo = low
        for i = 0 to math.min(bar_index, 900)
            if time[i] < chart.left_visible_bar_time
                break
            visHi := math.max(visHi, high[i])
            visLo := math.min(visLo, low[i])
        if visHi - visLo > atr * 3
            rowUnitG := (visHi - visLo) * lblPct / 100
    array<label> colA = array.new<label>()
    array<float> colHf = array.new<float>()
    if showExt and extLbls.size() > 0
        for i = 0 to extLbls.size() - 1
            colA.push(extLbls.get(i))
            colHf.push(extHf.size() > i ? extHf.get(i) : 1.0)
    if not na(pdhT)
        colA.push(pdhT)
        colHf.push(f_hf(szLvl))
    if not na(pdlT)
        colA.push(pdlT)
        colHf.push(f_hf(szLvl))
    if not na(vpPocLbl)
        colA.push(vpPocLbl)
        colHf.push(f_hf(szPoc))
    if fibLbls.size() > 0
        for i = 0 to fibLbls.size() - 1
            colA.push(fibLbls.get(i))
            colHf.push(fibHf.size() > i ? fibHf.get(i) : 1.0)
    if not na(h24_lb)
        colA.push(h24_lb)
        colHf.push(f_hf(szLiq))
    if not na(l24_lb)
        colA.push(l24_lb)
        colHf.push(f_hf(szLiq))
    if not na(posShortTag)
        colA.push(posShortTag)
        colHf.push(f_hf(szPos))
    if not na(posLongTag)
        colA.push(posLongTag)
        colHf.push(f_hf(szPos))
    if liqHigh.size() > 0
        for i = 0 to liqHigh.size() - 1
            LiqLevel qh = liqHigh.get(i)
            if not na(qh.lb) and f_near(qh.lvl)
                colA.push(qh.lb)
                colHf.push(f_hf(szLvl))
    if liqLow.size() > 0
        for i = 0 to liqLow.size() - 1
            LiqLevel ql = liqLow.get(i)
            if not na(ql.lb) and f_near(ql.lvl)
                colA.push(ql.lb)
                colHf.push(f_hf(szLvl))
    f_spread(colA, array.new<label>(), colHf, colLevels, 0)
    f_spread(infoLbls, cardIcons, cardHf, colCards, -2)

alertcondition(bullSig, "LONG confirmado", "🟢 LONG · {{ticker}} · {{interval}}")
alertcondition(bearSig, "SHORT confirmado", "🔴 SHORT · {{ticker}} · {{interval}}")
alertcondition(bullSig and ctxBias == "LONG", "LONG confirmado por ADX", "🟢✅ LONG confirmado por CONTEXTO ADX · {{ticker}} · {{interval}}")
alertcondition(bearSig and ctxBias == "SHORT", "SHORT confirmado por ADX", "🔴✅ SHORT confirmado por CONTEXTO ADX · {{ticker}} · {{interval}}")
alertcondition(sweepBullNow, "Barrido alcista de liquidez", "💧 Barrido de liquidez BAJISTA cazado (reversión alcista posible) · {{ticker}} · {{interval}}")
alertcondition(sweepBearNow, "Barrido bajista de liquidez", "💧 Barrido de liquidez ALCISTA cazado (reversión bajista posible) · {{ticker}} · {{interval}}")
alertcondition(pbNow, "Pullback a zona", "🔄 PULLBACK a zona (OB/FVG) · {{ticker}} · {{interval}}")
alertcondition(setupBullA, "Setup A+ LONG", "🐋 BALLENA + ZONA LONG = SETUP A+ · {{ticker}} · {{interval}}")
alertcondition(setupBearA, "Setup A+ SHORT", "🐋 BALLENA + ZONA SHORT = SETUP A+ · {{ticker}} · {{interval}}")
alertcondition(bullNear or bullIn or bullFNear or bullFIn, "Zona LONG cerca", "⚠ Precio acercándose a zona LONG (OB/FVG) · {{ticker}} · {{interval}}")
alertcondition(bearNear or bearIn or bearFNear or bearFIn, "Zona SHORT cerca", "⚠ Precio acercándose a zona SHORT (OB/FVG) · {{ticker}} · {{interval}}")
alertcondition(tStage == 2 and tStage[1] == 1, "TP1 tocado", "✅ TP1 tocado · SL en BE · {{ticker}}")
alertcondition(tStage == 3 and tStage[1] == 2, "TP2 tocado", "✅ TP2 tocado · SL en TP1 · {{ticker}}")
alertcondition(sTP3 != sTP3[1], "TP3 completado", "🏆 TP3 completado · {{ticker}}")
alertcondition(bosUp, "BOS Alcista", "⬆️ BOS alcista · {{ticker}}")
alertcondition(bosDn, "BOS Bajista", "⬇️ BOS bajista · {{ticker}}")
alertcondition(extTouch, "Precio toca liquidez externa", "🌊 El precio tocó un nivel de liquidez externa · {{ticker}} · {{interval}}")
