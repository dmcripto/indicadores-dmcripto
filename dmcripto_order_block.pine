//@version=6
indicator("DMCRIPTO ORDER BLOCK V3.0", shorttitle="DMOB V3", overlay=true, max_boxes_count=500, max_lines_count=300, max_labels_count=500, max_bars_back=1000)

// ------------------- MODO MÓVIL -------------------
grpMob = "📱 Modo Móvil"
mobileMode = input.bool(false, "Modo Móvil (adaptar tamaños y carga)", group=grpMob)

// ------------------- LIMPIEZA -------------------
grpClean = "🧹 Limpieza Visual"
masterClean   = input.bool(true, "Modo gráfico limpio", group=grpClean)
showBOSLabels = input.bool(true, "Mostrar estructura BOS/CHoCH (línea + texto)", group=grpClean, tooltip="BOS = el precio rompe un máximo/mínimo y sigue la tendencia. CHoCH = cambio de tendencia (la primera ruptura en contra). Se dibuja como una línea desde el pivote roto hasta la vela de ruptura, con el texto en el medio.")
delBreakers   = input.bool(true, "Borrar breakers después de tocados", group=grpClean, tooltip="Cuando un breaker (OB roto) es tocado, se elimina del gráfico en lugar de quedarse para siempre.")
showWhales    = input.bool(true, "Colorear velas ballena (volumen inusual)", group=grpClean, tooltip="Pinta la vela de amarillo fluor si el volumen inusual es alcista, o fucsia si es bajista. Sin triángulos ni etiquetas.")
whaleLen      = input.int(20, "Período promedio de volumen (ballenas)", minval=5, maxval=100, group=grpClean)
whaleMult     = input.float(2.5, "Múltiplo de volumen inusual", minval=1.2, step=0.1, group=grpClean)
whaleBuyColor = input.color(#CCFF00, "Color ballena alcista (amarillo fluor)", group=grpClean)
whaleSellColor = input.color(#FF00FF, "Color ballena bajista (fucsia)", group=grpClean)
whaleLookback = input.int(5, "Velas hacia atrás para contar ballena como confluencia", minval=1, maxval=20, group=grpClean, tooltip="Si hubo una vela ballena en las últimas X velas y el precio está cerca/en una zona, el panel marca SETUP A+.")
hideMitigated = input.bool(true, "Ocultar zonas consumidas", group=grpClean)

// ------------------- DETECCIÓN -------------------
grpDetect = "📦 Zonas (OB / FVG)"
swingLen     = input.int(5, "Longitud del pivote", minval=1, group=grpDetect)
lookback     = input.int(50, "Barras para buscar vela origen", minval=5, maxval=400, group=grpDetect)
showOB       = input.bool(true, "Mostrar Order Blocks", group=grpDetect)
maxOBsInput  = input.int(2, "Máx. Order Blocks simultáneos", minval=1, maxval=10, group=grpDetect, tooltip="Reducido por defecto (2) para evitar que muchas cajas se superpongan y saturen el gráfico.")
maxFZsInput  = input.int(3, "Máx. FVG simultáneos", minval=1, maxval=20, group=grpDetect, tooltip="Reducido por defecto (3) para evitar que muchas cajas se superpongan y saturen el gráfico.")
clusterATR = input.float(1.0, "Agrupar zonas más cerca que (x ATR) en una sola tarjeta", minval=0.5, step=0.5, group=grpDetect, tooltip="Si varias zonas están a menos de esta distancia entre sí (o se solapan), solo la más importante (OB antes que FVG) muestra tarjeta.")
cardMinATR = input.float(1.2, "Alto mínimo de caja para texto dentro (x ATR)", minval=0.3, step=0.1, group=grpDetect, tooltip="Si la caja de la zona mide entre este mínimo y el máximo, la tarjeta se escribe DENTRO de la caja. Si es más chica (el texto no entra) o más grande (el texto queda fuera de pantalla y el relleno tapa las velas), la tarjeta se dibuja a la derecha del precio.")
cardMaxATR = input.float(3.0, "Alto máximo de caja para texto dentro (x ATR)", minval=1.0, step=0.5, group=grpDetect, tooltip="Cajas más altas que esto no se rellenan con color fuerte ni llevan texto dentro: su tarjeta va a la derecha del precio.")
cardNearATR = input.float(3.0, "Zonas más cerca del precio que esto (x ATR) usan tarjeta lateral", minval=0.0, step=0.5, group=grpDetect, tooltip="Cerca del precio se amontonan velas y etiquetas (POSIBLE LONG/SHORT) y taparían el texto dentro de la caja. Las zonas a menos de esta distancia del precio muestran su tarjeta a la derecha; las más lejanas la llevan dentro de la caja.")
infoLblOffset = input.int(9, "Distancia de la tarjeta lateral a la derecha (velas)", minval=1, maxval=60, group=grpDetect, tooltip="Solo para zonas chicas, muy grandes o pegadas al precio: cuántas velas a la derecha de la última vela se dibuja la tarjeta. 9 la deja después de las etiquetas POSIBLE LONG/SHORT. Si algo la tapa, bajá o subí este número.")

// ------------------- ORDEN DEL GRÁFICO (para leer fácil) -------------------
grpTidy = "🧭 Orden del gráfico"
cardsSide   = input.bool(true, "Tarjeta con ⓘ dentro de cada zona, a la derecha de las velas", group=grpTidy, tooltip="ON (recomendado): cada zona OB/FVG se prolonga a la derecha y lleva dentro su tarjeta (con el icono ⓘ), sin tapar las velas. Pasa el mouse sobre la tarjeta para ver el análisis completo. OFF: comportamiento anterior.")
cardSimple  = input.bool(true, "Texto simple en las tarjetas (ZONA DE COMPRA / ZONA DE VENTA)", group=grpTidy, tooltip="ON: 2 líneas con palabras sencillas. OFF: el texto técnico completo (VOL, RVOL, Δ). El detalle completo siempre está al pasar el mouse por la tarjeta.")
maxSideCards = input.int(4, "Máx. tarjetas visibles (las más cercanas al precio)", minval=1, maxval=10, group=grpTidy, tooltip="Las zonas más lejanas quedan como ⓘ: pasa el mouse para ver su detalle.")
tidyRight   = input.bool(true, "Ordenar etiquetas de la derecha para que no se encimen", group=grpTidy, tooltip="Separa en vertical las etiquetas de niveles (PDH, PWH, liquidaciones...) y las tarjetas de zonas, cada grupo en su columna.")
colLevels   = input.int(1, "Columna de niveles y liquidaciones (velas a la derecha)", minval=1, maxval=60, group=grpTidy)
colCards    = input.int(12, "Posición de las tarjetas (velas a la derecha de la última)", minval=2, maxval=80, group=grpTidy, tooltip="Si las tarjetas se salen de la pantalla, bájalo o mueve el gráfico hacia la izquierda. Si se pisan con las etiquetas de niveles, súbelo.")
cardW       = input.int(6, "Largo de la zona detrás de la tarjeta (velas)", minval=2, maxval=80, group=grpTidy, tooltip="Cuánto se prolonga la caja de la zona a la derecha para que la tarjeta quede dentro de ella.")
pdReach     = input.int(14, "Largo de Premium / Discount / Equilibrio hacia la derecha (velas)", minval=2, maxval=60, group=grpTidy, tooltip="Hasta dónde llegan las franjas a la derecha de la última vela. Si pasan por debajo del panel y tapan su texto, bájalo.")
showEqBox   = input.bool(true, "Caja Equilibrio (50% del rango, entre barato y caro)", group=grpTidy, tooltip="Franja gris en el punto medio del último rango: por encima el precio está caro (premium), por debajo barato (descuento).")
tidyAuto    = input.bool(true, "Separación automática de etiquetas según el zoom del gráfico", group=grpTidy, tooltip="ON (recomendado): calcula cuánto espacio necesita cada etiqueta según lo que ves en pantalla (alto del precio visible), así no se pisan aunque cambies el zoom. OFF: usa el valor fijo de abajo (x ATR).")
lblPct      = input.float(4.6, "Alto de una etiqueta (% del precio visible) para la separación automática", minval=1.0, maxval=10.0, step=0.2, group=grpTidy, tooltip="Si siguen pisándose, súbelo (5.5, 6.5). Si quedan muy separadas, bájalo (3.5).")
rowGapATR   = input.float(0.4, "Alto de cada línea de texto (x ATR) para separar etiquetas", minval=0.1, maxval=1.0, step=0.05, group=grpTidy, tooltip="Si ves etiquetas pegadas o encimadas, súbelo (0.4, 0.5). Si quedan muy separadas, bájalo.")
grpFib = "📐 Fibonacci (zona de descuento)"
showFib    = input.bool(true, "Mostrar Fibonacci del último impulso (zona de descuento y golden pocket)", group=grpFib, tooltip="Usa el mismo tramo automático que Premium/Discount: si la tendencia es alcista, mide el retroceso desde el máximo hacia el mínimo del impulso. Zona de descuento = el precio devolvió el 50% o más de lo subido: ahí se busca comprar. Si es bajista se dibuja el espejo (zona de venta).")
fibLog     = input.bool(true, "Escala logarítmica (recomendado en cripto)", group=grpFib, tooltip="Calcula los niveles en escala logarítmica, como en el video: si no, los niveles salen mal en movimientos grandes. Si tu gráfico está en escala normal y el rango es chico, puedes apagarlo.")
fibGpA     = input.float(0.618, "Golden pocket: inicio", minval=0.5, maxval=0.9, step=0.001, group=grpFib)
fibGpB     = input.float(0.65, "Golden pocket: fin", minval=0.5, maxval=0.9, step=0.001, group=grpFib)
fibShow382 = input.bool(false, "Mostrar también el nivel 0.382", group=grpFib)
fibShow786 = input.bool(true, "Mostrar también el nivel 0.786", group=grpFib)
fibPlan    = input.bool(true, "Mostrar el plan: 2 compras, break even y salida parcial", group=grpFib, tooltip="Plan del video, solo informativo (no abre operaciones): 1ª compra en el 50%, 2ª en el golden pocket, break even cuando el precio promedio sube el % indicado, y venta parcial al tomar el máximo anterior.")
fibBEpct   = input.int(20, "Break even: cuando el precio suba (%) desde el promedio de entrada", minval=1, maxval=200, group=grpFib, tooltip="En el video: a +20% se protege la entrada poniendo el stop justo por encima del precio promedio. En timeframes cortos usa un valor menor (por ejemplo 3 o 5).")
fibTpPart  = input.int(50, "Salida parcial en el máximo anterior (% de la posición)", minval=10, maxval=100, group=grpFib)
grpVP = "📊 Perfil de volumen (zona con más negociación)"
showVP      = input.bool(true, "Mostrar perfil de volumen del último rango (POC y zona de valor)", group=grpVP, tooltip="Como el 'Perfil de volumen de rango fijo' de TradingView: reparte el volumen por precio según el fractal: si la tendencia es alcista, desde el mínimo fuerte (inicio del descuento) hasta el precio actual; si es bajista, desde el máximo fuerte (inicio del premium). POC = precio donde más se negoció (el más importante). Precio SOBRE el POC = sesgo alcista; BAJO el POC = bajista. Es una aproximación con las velas del gráfico.")
vpRows      = input.int(24, "Filas del perfil", minval=8, maxval=60, group=grpVP)
vpMaxBars   = input.int(300, "Máx. velas hacia atrás", minval=30, maxval=480, group=grpVP)
vpRight     = input.bool(true, "Perfil pegado a las últimas velas (como el VPVR de TradingView)", group=grpVP, tooltip="ON: las barras salen desde el borde derecho de las velas hacia la izquierda, siempre visibles. OFF: salen desde el inicio del rango (pueden quedar fuera de pantalla si el rango es largo).")
vpWidthBars = input.int(12, "Ancho máximo de las barras pegadas a la derecha (velas)", minval=5, maxval=80, group=grpVP)
vpWidthPct  = input.int(25, "Ancho máximo de las barras (% del rango en velas)", minval=5, maxval=60, group=grpVP)
vpVA        = input.int(70, "Zona de valor (% del volumen)", minval=50, maxval=95, group=grpVP)
vpDelta     = input.bool(true, "Colorear por quién dominó (verde compradores / rojo vendedores)", group=grpVP, tooltip="Aproxima el delta de cada fila con la posición del cierre dentro de cada vela.")
structKeep  = input.int(6, "Cuántas rupturas de estructura dejar dibujadas (BOS/CHoCH/iBOS/iCHoCH)", minval=2, maxval=30, group=grpTidy, tooltip="Solo se conservan las últimas para no llenar el gráfico.")
lvlLineBack = input.int(30, "Líneas de niveles: cuántas velas hacia atrás se dibujan (terminan en su etiqueta)", minval=0, maxval=200, group=grpTidy, tooltip="Las líneas punteadas de niveles (PDH, PWH, liquidaciones...) ya no cruzan todo el gráfico hasta el precio: empiezan unas velas atrás y terminan en su etiqueta. 0 = solo desde la última vela.")
shrinkMit   = input.bool(true, "Recortar cada zona OB/FVG: se borra la parte ya tocada y queda la que no", group=grpTidy, tooltip="Si el precio entró 20% en una zona, ese 20% se borra y queda dibujado el 80% restante. Cuando se toca por completo, la zona desaparece. Apágalo para ver siempre la zona entera.")
hideMitPrev = input.bool(true, "Borrar niveles previos (máx./mín. de ayer, semana, mes) cuando el precio ya los tocó", group=grpTidy, tooltip="Un nivel tocado ya no es liquidez pendiente: su etiqueta y su línea desaparecen para no llenar el gráfico. Apágalo si quieres ver siempre todos.")
showHHLL    = input.bool(true, "Marcar HH / HL / LH / LL en los pivotes", group=grpTidy, tooltip="HH = máximo más alto, HL = mínimo más alto (tendencia alcista); LH = máximo más bajo, LL = mínimo más bajo (tendencia bajista).")
showPDZ     = input.bool(true, "Zonas Premium (caro) y Discount (barato) del último rango", group=grpTidy, tooltip="Franja roja arriba del rango (zona cara para comprar, buena para vender) y verde abajo (zona barata para comprar).")
pdZonePct   = input.int(8, "Alto de las zonas Premium/Discount (% del rango)", minval=3, maxval=30, group=grpTidy)
showAssist = input.bool(true, "🤖 Asistente: mensaje simple de 'qué hacer ahora' en el panel", group=grpTidy, tooltip="Última fila del panel. Usa lo que ya calcula el indicador (zonas, filtros, señal, operación abierta) y lo dice en palabras simples. No es una recomendación de inversión.")
whyKeep     = input.int(2, "Cuántos avisos ⛔ dejar en el gráfico", minval=0, maxval=20, group=grpTidy, tooltip="Solo se conservan los últimos avisos de 'tocó zona pero no dio señal' para no llenar el gráfico.")
showInstTag  = input.bool(true, "Marcar OB institucionales con 🐋", group=grpDetect, tooltip="Institucional = la vela origen de la zona tuvo volumen inusual (ballena). Se marca con etiqueta 🐋 y color más vívido.")
instBorder   = input.bool(true, "Resaltar OB institucionales con color más vívido", group=grpDetect)
showBreakers = input.bool(true, "Mostrar Breakers", group=grpDetect)
showBRLabel  = input.bool(true, "Etiqueta 'BR' en breakers", group=grpDetect, tooltip="Cuando un OB se rompe y pasa a ser breaker, se marca con la etiqueta BR y borde punteado para diferenciarlo de un OB fresco.")
showFVG      = input.bool(true, "Mostrar FVG", group=grpDetect)
extendUntilMit = input.bool(true, "Extender zonas hasta ser mitigadas", group=grpDetect, tooltip="ESTÁNDAR SMC: las cajas de OB/FVG crecen vela a vela hasta que el precio las mitiga (la zona vive mientras no se toque). Al mitigarse se borran o se congelan como historial. Si lo apagas, usan la extensión fija de barras.")
showPB       = input.bool(true, "Marcar pullbacks a zonas (PB)", group=grpDetect, tooltip="RECOMENDADO ON: cuando el precio entra por primera vez a un OB o FVG activo se marca PB (máx. 1 por vela). Es la marca visual del momento de toque. Apágalo cuando ya lo leas de memoria o en scalping 1-5m.")
showSweepTag = input.bool(false, "Mostrar etiqueta 💧 en barridos de liquidez", group=grpDetect, tooltip="Marca con 💧 la vela que barre liquidez. Desactivado por defecto para limpieza; las alertas de barrido siguen funcionando igual.")
obExtendBars = input.int(50, "Extensión fija (solo si apagas 'extender')", minval=5, group=grpDetect)
useATRFilter = input.bool(true, "Tamaño mínimo vela origen (ATR)", group=grpDetect)
atrLen       = input.int(14, "Longitud ATR", group=grpDetect)
useAutoATRMult = input.bool(true, "Filtro de calidad de zona automático (según timeframe)", group=grpDetect, tooltip="ON por defecto: exige velas origen más grandes (más selectivo) en 1-5m, donde hay más ruido, y menos exigente en 15m.")
minATRMultManual = input.float(0.5, "Mínimo x ATR (manual)", minval=0.05, step=0.05, group=grpDetect, tooltip="Solo se usa si el filtro automático está OFF.")
tfSecEarly = timeframe.in_seconds()
minATRMultAuto = tfSecEarly <= 180 ? 0.8 : tfSecEarly <= 300 ? 0.7 : tfSecEarly <= 900 ? 0.6 : 0.5
minATRMult = useAutoATRMult ? minATRMultAuto : minATRMultManual
nearMult     = input.float(1.0, "Avisar 'ZONA CERCA' a esta distancia (x ATR)", minval=0.25, step=0.25, group=grpDetect, tooltip="Cuando el precio queda a esta distancia (en ATRs) de una zona activa, el panel te avisa indicando el tipo de zona.")
showZoneStrength = input.bool(true, "Clasificar fuerza de zona (Débil/Moderado/Fuerte)", group=grpDetect, tooltip="Clasifica cada Order Block según el volumen relativo (RVOL) de su vela origen. Se muestra en el panel, sin añadir etiquetas nuevas al gráfico.")
rvolFuerte = input.float(2.0, "RVOL mínimo para FUERTE", minval=1.0, step=0.1, group=grpDetect)
rvolModerado = input.float(1.0, "RVOL mínimo para MODERADO", minval=0.1, step=0.1, group=grpDetect)
requireZoneStrength = input.bool(false, "Exigir fuerza mínima (MODERADO+) para señal", group=grpDetect, tooltip="OFF por defecto: pruébalo antes de activarlo. Si se activa, una señal LONG/SHORT solo nace si el Order Block tocado tiene RVOL Moderado o Fuerte (descarta toques en zonas DÉBILES con poco volumen real detrás). Solo afecta a OB: los FVG son informativos y no generan señales por sí solos.")
showZoneInfoBox = input.bool(true, "Colorear OB/FVG según fuerza (Débil/Moderado/Fuerte)", group=grpDetect, tooltip="Pinta la caja de cada OB/FVG según su fuerza: gris=DÉBIL, naranja=MODERADO, verde/rojo=FUERTE (alcista/bajista). Azul/morado = breaker.")
showInternalStruct = input.bool(true, "Mostrar estructura interna (iBOS/iCHoCH)", group=grpDetect, tooltip="Marca rupturas de estructura menores (internas) dentro de la tendencia principal, usando un pivote más corto. Solo se muestra la última etiqueta para no saturar el gráfico.")
internalSwingLen = input.int(3, "Longitud pivote interno (iBOS/iCHoCH)", minval=1, group=grpDetect)

// ==================== 🧠 SMART MONEY + VOLUMEN (mejoras) ====================
grpSM = "🧠 Smart Money + Volumen"
obLegOnly     = input.bool(true, "Buscar la vela origen solo en el tramo del impulso", group=grpSM, tooltip="ON: el OB se busca entre el último pivote y la ruptura (la vela que realmente originó el movimiento), no en las últimas N velas. Menos OB viejos y menos ruido. OFF: comportamiento anterior.")
swingBigLen   = input.int(25, "Longitud del pivote SWING (OB swing)", minval=5, group=grpSM, tooltip="Un OB es SWING cuando su ruptura también rompe un pivote de esta longitud (ruptura importante, entran los grandes actores). Se marca con SWING y borde grueso.")
domTh         = input.float(10.0, "Dominancia neutral si |Δ| menor a (%)", minval=0.0, step=1.0, group=grpSM, tooltip="Δ >= valor = COMPRADORES, Δ <= -valor = VENDEDORES, en medio = NEUTRAL.")
showDom       = input.bool(true, "Mostrar dominancia en la tarjeta", group=grpSM)
pctMode       = input.string("DISP.", "Texto del % restante de la zona", options=["DISP.", "INTEGRIDAD"], group=grpSM, tooltip="100% = zona virgen. Baja conforme el precio la consume.")
dimInteg      = input.float(50.0, "Atenuar zonas con integridad menor a (%)", minval=0.0, maxval=100.0, step=5.0, group=grpSM)
obMinRvol     = input.float(0.0, "Filtro de ruido: RVOL mínimo para crear un OB", minval=0.0, step=0.1, group=grpSM, tooltip="0 = sin filtro. Con 1.0 solo nacen OB con volumen al menos igual al promedio.")
showFvgPct    = input.bool(true, "Mostrar % disponible dentro de cada FVG", group=grpSM)
requireReject = input.bool(true, "Exigir vela de rechazo dentro de la zona para la señal", group=grpSM, tooltip="ON: LONG solo si la vela cierra alcista y sobre el fondo del OB; SHORT solo si cierra bajista y bajo el techo. Si el toque no confirma, la zona sigue viva y puede dar señal en una vela posterior.")
requireDomOK  = input.bool(true, "Bloquear señales en zonas con dominancia contraria", group=grpSM, tooltip="LONG no entra en un OB cuyo Δ indica VENDEDORES; SHORT no entra si indica COMPRADORES.")

showTips      = input.bool(true, "Análisis completo al pasar el mouse sobre la tarjeta (ⓘ)", group=grpSM, tooltip="Cada tarjeta de zona muestra al pasar el mouse (o tocarla en el móvil) el análisis completo: formación, estado, componentes del score y lectura. Las zonas agrupadas en una tarjeta aparecen todas en el mismo análisis.")
scoreStrength = input.bool(true, "Fuerza del OB según el Score de calidad", group=grpSM, tooltip="ON: DÉBIL/MODERADO/FUERTE sale del Score 0-100 (order flow, desplazamiento, frescura, RVOL y FVG), como en el análisis del mouse. OFF: solo por RVOL.")
scoreStrong   = input.int(60, "Score mínimo para FUERTE", minval=1, maxval=100, group=grpSM)
scoreMod      = input.int(40, "Score mínimo para MODERADO", minval=1, maxval=100, group=grpSM)

fvgSignals    = input.bool(true, "Las zonas FVG también pueden dar señal", group=grpSM, tooltip="Antes solo los Order Blocks daban señal y los FVG eran informativos. Con esto, el primer toque a un FVG con vela de rechazo (y sin dominancia contraria) también genera LONG o SHORT, con el SL más allá del hueco. Los FVG son mucho más frecuentes que los OB.")
showWhy       = input.bool(true, "Mostrar ⛔ cuando una zona tocada NO da señal, y qué filtro la bloqueó", group=grpSM, tooltip="En la vela del toque aparece una etiqueta gris, por ejemplo 'SHORT ⛔ oscilador ADX', con los filtros que la frenaron. Sirve para ver qué ajustar.")

// ==================== 🧰 SESIÓN, RIESGO Y COSTOS ====================
grpRisk = "🧰 Sesión, riesgo y costos"
useSessFilter = input.bool(false, "Filtro de sesión: operar solo en las sesiones elegidas", group=grpRisk, tooltip="Usa los horarios y la zona horaria del grupo 'Niveles de Sesión y Referencia'. Fuera de las sesiones permitidas no nace ninguna señal.")
allowAsia     = input.bool(false, "Permitir señales en sesión Asia", group=grpRisk)
allowLDN      = input.bool(true, "Permitir señales en sesión Londres", group=grpRisk)
allowNY       = input.bool(true, "Permitir señales en sesión Nueva York", group=grpRisk)
showPosSize   = input.bool(true, "Mostrar tamaño de posición en el panel", group=grpRisk, tooltip="Calcula el tamaño para arriesgar el % elegido de tu capital hasta el SL de la operación activa. Es el tamaño nocional: si usas apalancamiento, el margen es menor.")
acctSize      = input.float(1000.0, "Capital de la cuenta", minval=1.0, group=grpRisk)
riskPct       = input.float(1.0, "Riesgo por operación (%)", minval=0.05, step=0.05, group=grpRisk)
feePct        = input.float(0.06, "Comisión por lado (%) para las estadísticas", minval=0.0, step=0.01, group=grpRisk, tooltip="Se descuenta en R de 'Netos' en cada señal (entrada y salida). 0.06% es una comisión típica de futuros; ajústala a tu exchange.")
slipPct       = input.float(0.02, "Deslizamiento por lado (%) para las estadísticas", minval=0.0, step=0.01, group=grpRisk)

// ==================== 🔗 CONEXIÓN CON OSCILADOR V3.0 ====================
grpLink = "🔗 Conexión con OSCILADOR V3.0"
useOscLink     = input.bool(true, "Activar conexión con el oscilador", group=grpLink, tooltip="Activada por defecto. Requiere tener el OSCILADOR V3.0 en el mismo gráfico y temporalidad. Pine no permite preseleccionar las series de otro indicador: elígelas una sola vez abajo y guarda el layout o una plantilla para que TradingView las recuerde. Mientras no sean válidas, el filtro se ignora y el panel lo avisa.")
srcOscSig      = input.source(close, "Serie: Señal (+1 LONG / −1 SHORT)", group=grpLink)
srcOscScoreL   = input.source(close, "Serie: Puntaje LONG", group=grpLink)
srcOscScoreS   = input.source(close, "Serie: Puntaje SHORT", group=grpLink)
minLinkScore   = input.int(40, "Puntaje mínimo del oscilador para permitir la señal", minval=0, maxval=100, group=grpLink, tooltip="Una señal LONG de este indicador solo nace si el puntaje LONG del oscilador alcanza este valor, y una SHORT si lo alcanza el puntaje SHORT.")
requireOscSig  = input.bool(false, "Exigir además una señal reciente del oscilador en la misma dirección", group=grpLink, tooltip="Más estricto: el oscilador debe haber emitido su propia señal LONG/SHORT dentro de la vigencia.")
linkWindow     = input.int(10, "Vigencia de la señal del oscilador (velas)", minval=1, maxval=50, group=grpLink)

// ==================== 🌊 LIQUIDEZ EXTERNA (pegada desde tu app o API) ====================
grpExt = "🌊 Liquidez externa (pegar desde tu app o API)"
showExt     = input.bool(true, "Dibujar liquidez externa y automática (interruptor general)", group=grpExt)
showAuto    = input.bool(true, "Automático: máximos y mínimos previos (día, semana y mes)", group=grpExt, tooltip="PDH/PDL, PWH/PWL y PMH/PML: los extremos del día, la semana y el mes anteriores, donde suelen acumularse órdenes. Se calculan solos desde el gráfico.")
showEst     = input.bool(true, "Automático: liquidaciones estimadas por apalancamiento", group=grpExt, tooltip="ESTIMACIÓN, no dato real de liquidaciones. Desde el último máximo importante calcula dónde se liquidarían largos abiertos ahí con cada apalancamiento, y desde el último mínimo importante dónde se liquidarían cortos. Solo muestra los niveles que el precio aún no ha cruzado. Para datos reales de liquidaciones pégalos abajo.")
estPivLen   = input.int(30, "Pivote del swing para las liquidaciones estimadas (velas a cada lado)", minval=5, group=grpExt)
estLev1     = input.int(25, "Apalancamiento estimado 1", minval=2, group=grpExt)
estLev2     = input.int(50, "Apalancamiento estimado 2", minval=2, group=grpExt)
estLev3     = input.int(100, "Apalancamiento estimado 3", minval=2, group=grpExt)
extText     = input.text_area("", "Niveles (uno por línea)", group=grpExt, tooltip="Formato por línea: precio;tipo;texto;monto. Tipos: LIQ_LONG (liquidaciones de largos, bajo el precio), LIQ_SHORT (liquidaciones de cortos, sobre el precio), SOPORTE, RESISTENCIA o NIVEL. El texto y el monto (en millones) son opcionales. Ejemplo: 82500;LIQ_SHORT;Cluster de cortos;120. Las líneas que empiezan con # se ignoran. Máximo 40 niveles. Son una foto del momento en que los pegas, no un dato en vivo.")
extLongCol  = input.color(color.new(#FFEB3B, 0), "Color liquidaciones de largos", group=grpExt)
extShortCol = input.color(color.new(#FF4081, 0), "Color liquidaciones de cortos", group=grpExt)
extUseSL    = input.bool(true, "Proteger el SL: ponerlo más allá de la liquidación cercana a la zona", group=grpExt, tooltip="LONG: si hay un nivel LIQ_LONG justo bajo el OB, el SL queda por debajo de él. SHORT: si hay un LIQ_SHORT justo sobre el OB, el SL queda por encima. Solo actúa en señales en vivo, nunca en el historial, porque los niveles pegados son una foto actual y alterarían las estadísticas pasadas.")
extSlRange  = input.float(1.5, "Alcance para buscar esa liquidación (x ATR desde la zona)", minval=0.2, step=0.1, group=grpExt)

// ==================== 5. 💧 LIQUIDEZ ====================
grpLiq = "💧 Liquidez (EQH/EQL/24h/SR)"
showLiq    = input.bool(true, "Mostrar liquidez EQH/EQL", group=grpLiq)
liqLen     = input.int(3, "Pivote de liquidez", minval=2, group=grpLiq)
liqTolATR  = input.float(0.25, "Tolerancia (x ATR)", step=0.05, group=grpLiq)
liqCol     = input.color(color.new(color.aqua, 20), "Color liquidez normal", group=grpLiq)
srMin      = input.int(2, "🧱 Toques para volver S/R", minval=2, maxval=8, group=grpLiq, tooltip="Cuando una línea de liquidez es tocada N veces, se convierte en S/R (soporte/resistencia confirmada) y cambia de color.")
srCol      = input.color(color.new(color.white, 0), "Color S/R (en desuso: ahora hay color por tipo)", group=grpLiq)
supCol     = input.color(color.new(#2962FF, 0), "Color SOPORTE automático", group=grpLiq)
resCol     = input.color(color.new(#FF9800, 0), "Color RESISTENCIA automática", group=grpLiq)
srMaxATR   = input.float(8.0, "Distancia máxima para mostrar líneas de liquidez y S/R (x ATR del precio)", minval=0.0, step=1.0, group=grpLiq, tooltip="Las líneas más lejanas que esto se ocultan, junto con su texto y su marca en la escala, para que TradingView no aplaste las velas al ajustar la escala vertical. Siguen guardadas y reaparecen cuando el precio se acerca. 0 = mostrar todas. No afecta a los niveles pegados en liquidez externa.")
showSRLabel = input.bool(true, "Texto SOPORTE / RESISTENCIA con precio en la línea", group=grpLiq, tooltip="Cuando un nivel de liquidez es rechazado las veces indicadas se dibuja solo como línea de soporte (azul) o resistencia (naranja), con su texto. Los soportes y resistencias no se borran al entrar niveles nuevos, solo cuando el precio los rompe.")
liqHint    = input.bool(true, "Etiquetas POSIBLE LONG/SHORT (solo la más cercana)", group=grpLiq, tooltip="Muestra MÁXIMO 2 etiquetas en el chart: POSIBLE SHORT = liquidez más cercana por encima del precio · POSIBLE LONG = más cercana por debajo. El resto de niveles solo se ve como línea + precio en la barra lateral.")
maxLiq     = input.int(2, "Máx. líneas por lado", minval=1, maxval=10, group=grpLiq, tooltip="Reducido a 2 por defecto para menos saturación visual.")
showLiq24  = input.bool(true, "🕐 Liquidez 24h (día anterior)", group=grpLiq, tooltip="ON por defecto: dibuja las líneas de máximo/mínimo de las últimas 24h y llena el panel 'Liq 24h ↑/↓'. Solo es informativo: no exige nada para las señales (eso lo controla 'Exigir barrido de liquidez reciente', que sigue en OFF).")
liq24Col   = input.color(color.new(color.fuchsia, 0), "Color liquidez 24h", group=grpLiq)
requireSweep = input.bool(false, "Exigir barrido de liquidez reciente para señales", group=grpLiq, tooltip="Si se activa, las señales LONG/SHORT solo nacen si hubo un barrido de liquidez (💧) en las últimas 10 velas. Recomendado dejarlo OFF y usarlo como confluencia visual.")

grpStyle = "🎨 Estilo"
bullOBcol  = input.color(color.new(color.teal, 90), "OB Alcista", group=grpStyle)
bearOBcol  = input.color(color.new(color.red, 90), "OB Bajista", group=grpStyle)
bullBRcol  = input.color(color.new(color.blue, 85), "Breaker Alcista", group=grpStyle)
bearBRcol  = input.color(color.new(color.purple, 85), "Breaker Bajista", group=grpStyle)
fvgBullCol = input.color(color.new(color.teal, 94), "FVG Alcista", group=grpStyle)
fvgBearCol = input.color(color.new(color.red, 94), "FVG Bajista", group=grpStyle)

